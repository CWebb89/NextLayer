+std::string GCodeGenerator::extrude_inlayer(
+    const Domain::InLayerExtrusions& extrusions,
+    const double print_z,
+    const Domain::ConfigView& object_config
+) {
+    std::string gcode;
+    if (extrusions.polylines.empty())
+        return gcode;
+
+    const std::vector<double> diameters{m_print->config().get<std::vector<double>>("filament_diameter")};
+    if (diameters.empty())
+        return gcode;
+    const unsigned int extruder_id{std::min<unsigned int>(extrusions.extruder, static_cast<unsigned int>(diameters.size()) - 1)};
+    if (m_writer.extruder()->id() != extruder_id)
+        gcode += this->set_extruder(extruder_id, print_z, object_config);
+
+    gcode += ";" + std::string(Biz::libpgcode::reserved_tag(Biz::libpgcode::Tags::Custom_Code)) + "\n";
+
+    const double filament_area{M_PI * 0.25 * diameters[extruder_id] * diameters[extruder_id]};
+    if (filament_area <= 0.0)
+        return gcode;
+
+    for (const Domain::InLayerPolyline& polyline : extrusions.polylines) {
+        if (polyline.points.size() < 2)
+            continue;
+
+        if (!polyline.gcode.empty()) {
+            gcode += polyline.gcode;
+            if (polyline.gcode.back() != '\n')
+                gcode += '\n';
+        }
+        gcode += m_writer.travel_to_z(print_z);
+        gcode += m_writer.travel_to_xy(polyline.points.front(), "calibration");
+        gcode += this->unretract();
+        gcode += m_writer.set_speed(polyline.speed * 60.0);
+
+        const double e_per_mm{polyline.line_width * polyline.layer_height / filament_area};
+        for (std::size_t i{1}; i < polyline.points.size(); ++i) {
+            const double length{(polyline.points[i] - polyline.points[i - 1]).norm()};
+            if (length <= 0.0)
+                continue;
+            gcode += m_writer.extrude_to_xy(polyline.points[i], length * e_per_mm, "calibration");
+        }
+        gcode += m_writer.retract();
+    }
+
+    return gcode;
+}
