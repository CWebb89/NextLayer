diff --git a/src/slic3r-domain/include/Slic3r/Domain/InLayerExtrusions.hpp b/src/slic3r-domain/include/Slic3r/Domain/InLayerExtrusions.hpp
new file mode 100644
index 0000000..12f482f
--- /dev/null
+++ b/src/slic3r-domain/include/Slic3r/Domain/InLayerExtrusions.hpp
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <vector>
+
+#include "Slic3r/Domain/Point.hpp"
+
+namespace Slic3r::Domain {
+
+/// One polyline a print asked the generator to extrude inside a layer, on top of
+/// the layer's own geometry. Coordinates are printer millimetres in bed space.
+/// The generator owns the extruder position, the E value and the feedrate, so a
+/// caller supplies geometry and nothing that could desynchronise the machine
+/// state between two of the layer's own moves.
+struct InLayerPolyline
+{
+    std::vector<Vec2d> points;
+    double line_width{0.45};
+    double layer_height{0.2};
+    double speed{50.0};
+    /// Written before the travel to this polyline's first point. It is for state
+    /// the geometry cannot express — a pressure-advance value, a temperature — and
+    /// it may not extrude or move the extruder, because the generator's own idea of
+    /// where the nozzle is stands until it emits the next move.
+    std::string gcode;
+};
+
+/// The polylines to extrude in the layer whose print Z matches, written after
+/// that layer's object geometry and before the next layer starts.
+struct InLayerExtrusions
+{
+    double print_z{0.0};
+    unsigned int extruder{0};
+    std::vector<InLayerPolyline> polylines;
+};
+
+} // namespace Slic3r::Domain
