    ")": 11, "_": 12, "+": 13, "{": 26, "}": 27, "|": 43, ":": 39, '"': 40,
    "<": 51, ">": 52, "?": 53, "~": 41,
}


def key_names() -> dict[str, int]:
    """Map KEY_<NAME> from the kernel header, so names are never guessed."""
    names: dict[str, int] = {}
    try:
        with open(INPUT_CODES, encoding="utf-8") as header:
            for line in header:
                if not line.startswith("#define KEY_"):
                    continue
                parts = line.split()
                if len(parts) < 3:
                    continue
                try:
                    names[parts[1][4:].lower()] = int(parts[2], 0)
                except ValueError:
                    continue
    except FileNotFoundError:
        pass
    return names


class Input:
    """A throwaway virtual device created for the length of one command.

    Pointer and keyboard are separate devices, not one combo device. Composed
    together, libinput classified the node as a pointer and the compositor
    delivered its button presses while dropping every key event, so typing and
    Escape silently did nothing. A device that advertises only EV_KEY is a
    keyboard to libinput, and its keys arrive.
    """

    def __init__(self, name: str = "cockpit-pointer", kind: str = "pointer") -> None:
        self.name = name
        self.fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_SYN)
        if kind == "pointer":
            fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_REL)
            for code in set(BUTTONS.values()):
                fcntl.ioctl(self.fd, UI_SET_KEYBIT, code)
            for axis in (0x00, 0x01, WHEEL_VERTICAL, WHEEL_HORIZONTAL):
                fcntl.ioctl(self.fd, UI_SET_RELBIT, axis)
        else:
            # Every keyboard code the kernel knows: Escape is 1, and a device
            # that does not advertise a key has its events dropped.
            for code in range(1, 256):
                fcntl.ioctl(self.fd, UI_SET_KEYBIT, code)

        device = struct.pack(
            "80sHHHHi", name.encode(), BUS_USB, 0x1234, 0x5678, 1, 0
        ) + struct.pack("64i", *([0] * 64)) * 4
        os.write(self.fd, device)
        fcntl.ioctl(self.fd, UI_DEV_CREATE)
        # libinput drops events from a device it has not finished opening yet: a
        # device created and clicked 60 ms later lost the press roughly half the
        # time, which reads as "the app ignored my click". Wait for the udev/libinput
        # handshake instead of guessing a frame time.
        deadline = time.monotonic() + 2.0
        while time.monotonic() < deadline and not self._ready():
            time.sleep(0.02)
        # libinput finishes opening the node after the kernel publishes it, and
        # the first key of a brand-new keyboard is dropped while that happens:
        # "voron" arrived as "voro". A keyboard waits longer than a pointer,
        # which only loses a click that is repeated anyway.
        time.sleep(0.30 if kind == "keyboard" else 0.05)

    def _ready(self) -> bool:
        """True once the kernel has published this device's node."""
        for path in glob.glob("/sys/class/input/event*/device/name"):
            try:
                with open(path, encoding="utf-8") as handle:
                    if handle.read().strip() == self.name:
                        return True
            except OSError:
                continue
        return False

    def _emit(self, kind: int, code: int, value: int) -> None:
        os.write(self.fd, struct.pack("llHHi", 0, 0, kind, code, value))

    def sync(self) -> None:
        self._emit(EV_SYN, 0, 0)
        time.sleep(0.012)

    def key(self, code: int, value: int) -> None:
        self._emit(EV_KEY, code, value)
        self.sync()

    def tap(self, code: int, modifiers: list[int] | None = None) -> None:
        for modifier in modifiers or []:
            self._emit(EV_KEY, modifier, 1)
        self._emit(EV_KEY, code, 1)
        self._emit(EV_KEY, code, 0)
        for modifier in reversed(modifiers or []):
            self._emit(EV_KEY, modifier, 0)
        self.sync()

    def relative(self, dx: int, dy: int) -> None:
        while dx or dy:
            step_x = max(-60, min(60, dx))
            step_y = max(-60, min(60, dy))
            dx -= step_x
            dy -= step_y
            if step_x:
                self._emit(EV_REL, 0x00, step_x)
            if step_y:
                self._emit(EV_REL, 0x01, step_y)
            self.sync()

    def button(self, name: str, pressed: bool) -> None:
        self._emit(EV_KEY, BUTTONS[name], 1 if pressed else 0)
        self.sync()

    def scroll(self, amount: int, horizontal: bool = False) -> None:
        axis = WHEEL_HORIZONTAL if horizontal else WHEEL_VERTICAL
        steps = amount if abs(amount) <= 12 else (12 if amount > 0 else -12)
        self._emit(EV_REL, axis, steps)
        self.sync()
        remaining = amount - steps
        if remaining:
            self.scroll(remaining, horizontal)

    def close(self) -> None:
        try:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
        finally:
            os.close(self.fd)


# ----------------------------------------------------------------- session ---


def state_path(app: str) -> str:
    return os.path.join(STATE_DIR, f"{app}.json")


def load_state(app: str | None) -> dict:
    if app is None:
        raise SystemExit("cockpit: which session? pass --app or use a single running session")
    path = state_path(app)
    if not os.path.exists(path):
        raise SystemExit(f"cockpit: no session for {app!r} (start one first)")
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def save_state(app: str, state: dict) -> None:
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(state_path(app), "w", encoding="utf-8") as handle:
        json.dump(state, handle, indent=2)


def sessions() -> dict[str, dict]:
    found: dict[str, dict] = {}
    if not os.path.isdir(STATE_DIR):
        return found
    for entry in sorted(os.listdir(STATE_DIR)):
        if not entry.endswith(".json"):
            continue
        try:
            with open(os.path.join(STATE_DIR, entry), encoding="utf-8") as handle:
                found[entry[:-5]] = json.load(handle)
        except (OSError, json.JSONDecodeError):
            continue
    return found


def app_windows(name: str, workspace: int | None = None) -> list[dict]:
    """Every window that belongs to this app, matched by class.

    The class is what the compositor reports ("next-layer-qt", "orca-slicer"),
    the title starts with the app name, and a session may not exist yet, so both
    are tried. Titles are never matched: a terminal whose title happens to name
    the app is not the app, and adopting one is how `stop` once closed the
    agent's own terminal.
    """
    wanted = name.lower()
    found = []
    for client in clients():
        if workspace is not None and client["workspace"]["id"] != workspace:
            continue
        if wanted and wanted in str(client.get("class", "")).lower():
            found.append(client)
    return found


def main_window(state: dict) -> dict:
    """The session's own window, re-resolved by class on its workspace.

    Addresses change: a reference app replaces its window during start-up, and a
    fullscreen toggle can remap it. The class on the session workspace is the
    stable key.
    """
    wanted = state.get("class", "")
    on_workspace = app_windows(state["app"], state["ws"])
    for client in on_workspace:
        if client.get("address") == state.get("address") and client.get("class", "") == wanted:
            return client
    for client in on_workspace:
        if wanted and client.get("class") == wanted:
            state["address"] = client["address"]
            save_state(state["app"], state)
            return client
    raise SystemExit("cockpit: the session window is gone; run `cockpit stop` then start again")


def focused_window() -> dict | None:
    current = hypr_json("-j", "activewindow")
    return current if current.get("address") else None


def window_label(client: dict) -> str:
    return (f"{client['address']} {client.get('title', '')!r} "
            f"{client['size'][0]}x{client['size'][1]} "
            f"at {client['at'][0]},{client['at'][1]}")


def match_window(spec: str, candidates: list[dict]) -> dict:
    """Resolve a window spec: an address prefix, a title glob or an index.

    A title spec is what a person reads off `cockpit windows`, so a substring and
    a glob both work; the focused window wins when several titles match.
    """
    text = spec.strip()
    lowered = text.lower()
    focused = focused_window()
    for client in candidates:
        if client["address"].lower().startswith(lowered):
            return client
    titled = [client for client in candidates
              if lowered in str(client.get("title", "")).lower()
              or fnmatch.fnmatch(str(client.get("title", "")).lower(), lowered)]
    for client in titled:
        if focused and client["address"] == focused["address"]:
            return client
    if titled:
        return titled[0]
    if text.lstrip("-").isdigit():
        index = int(text)
        if -len(candidates) <= index < len(candidates):
            return candidates[index]
    visible = ", ".join(repr(client.get("title", "")) for client in candidates) or "none"
    raise SystemExit(f"cockpit: no window matches {spec!r}; open windows are: {visible}")


def resolve_target(state: dict, spec: str | None = None, announce: bool = True) -> dict:
    """The window this command acts on.

    Order: `--window`, then the session's remembered target (set by the last
    click, or by `window`), then the focused window on the session workspace,
    then the app's main window. The remembered target is what keeps a sequence
    pointed at the dialog it just opened: a modal one takes focus, but focus is
    not something a script should have to re-read after every step.
    """
    main = main_window(state)
    candidates = app_windows(state["app"], state["ws"])
    if spec:
        target = match_window(spec, app_windows(state["app"]) or candidates)
    else:
        target = None
        remembered = state.get("target")
        if remembered:
            for client in candidates:
                if client["address"] == remembered:
                    target = client
                    break
            else:
                state.pop("target", None)
                save_state(state["app"], state)
        if target is None:
            focused = focused_window()
            for client in candidates:
                if focused and client["address"] == focused["address"]:
                    target = client
                    break
        if target is None:
            target = main
    if announce:
        note_target(state, target, main)
    return target


def note_target(state: dict, target: dict, main: dict) -> None:
    """Say when the target is not the main window -- once, when it changes.

    Silence here is what let a stale popup eat clicks for a whole session: the
    coordinates were right for the window the tool believed it was driving.
    """
    if target["address"] == main["address"]:
        if state.get("reported") not in (None, "main"):
            print(f"cockpit: target back to the main window {main.get('title', '')!r}")
            state["reported"] = "main"
            save_state(state["app"], state)
        return
    if state.get("reported") != target["address"]:
        print(f"cockpit: target {target.get('title', '')!r} {target['address']} "
              f"(not the main window)")
        state["reported"] = target["address"]
        save_state(state["app"], state)


def remember_target(state: dict, target: dict) -> None:
    if state.get("target") != target["address"]:
        state["target"] = target["address"]
        save_state(state["app"], state)


def monitor_origin_of(client: dict) -> tuple[int, int]:
    """Top-left of the monitor this window sits on, in global pixels."""
    left, top = client["at"]
    for monitor in hypr_json("-j", "monitors"):
        if (monitor["x"] <= left < monitor["x"] + monitor["width"]
                and monitor["y"] <= top < monitor["y"] + monitor["height"]):
            return int(monitor["x"]), int(monitor["y"])
    return 0, 0


def to_global(target: dict, x: float, y: float) -> tuple[int, int]:
    """Window pixels -> screen pixels. The one conversion this tool has."""
    left, top = target["at"]
    width, height = target["size"]
    if not (0 <= x <= width and 0 <= y <= height):
        print(f"cockpit: warning: ({x:g}, {y:g}) is outside the {width}x{height} window "
              f"{target.get('title', '')!r}", file=sys.stderr)
    return int(left + x), int(top + y)


def to_window(target: dict, x: float, y: float) -> tuple[int, int]:
    """Screen pixels -> window pixels."""
    left, top = target["at"]
    return int(round(x - left)), int(round(y - top))


def frame_header(target: dict) -> str:
    return (f"frame window {target['address']} {target['size'][0]}x{target['size'][1]} "
            f"{target.get('title', '')!r} at {target['at'][0]},{target['at'][1]} "
            f"-- coordinates are window pixels")


# ---------------------------------------------------------------- commands ---


def adopt_window(name: str, client: dict) -> dict:
    state = {"app": name, "ws": client["workspace"]["id"], "return_ws": active_workspace(),
             "address": client["address"], "class": client.get("class", ""),
             "command": "", "started": time.time()}
    save_state(name, state)
    return state


def cmd_start(args: argparse.Namespace) -> int:
    state = sessions().get(args.app)
    if state is not None:
        try:
            main_window(state)
            print(f"cockpit: {args.app} is already running on workspace {state['ws']}")
            return 1
        except SystemExit:
            os.unlink(state_path(args.app))

    # One instance is the rule: a second window of the same app is a second
    # process fighting over the same QSettings, the same presets and the same
    # scratch directory, and a functional test does not need two.
    existing = app_windows(args.app)
    if existing and not args.workspace:
        window = existing[0]
        state = adopt_window(args.app, window)
        print(f"cockpit: reusing {args.app} already open on workspace {state['ws']}")
        focus_workspace(state["ws"])
        time.sleep(0.2)
        hypr("dispatch", f'hl.dsp.focus({{window="address:{window["address"]}"}})')
        return 0

    workspace = args.workspace or free_workspace()
    here = active_workspace()
    focus_workspace(workspace)
    time.sleep(0.25)

    command = args.command or args.app
    if args.arg:
        command = f"{command} {' '.join(shlex.quote(value) for value in args.arg)}"
    if args.model:
        command = f"{command} {shlex.quote(os.path.abspath(args.model))}"

    # hyprctl dispatches the command to the compositor, so the app's stdout and
    # stderr go nowhere a caller can read. Redirecting them here is the only reason
    # `cockpit log` can exist. QT_ASSUME_STDERR_HAS_CONSOLE is what keeps it non-empty:
    # Qt drops every message -- warnings and QML console.log alike -- when stderr is
    # not a terminal, and a redirected file is not one.
    os.makedirs(STATE_DIR, exist_ok=True)
    log = log_path(args.app)
    with open(log, "w", encoding="utf-8"):
        pass
    command = f"QT_ASSUME_STDERR_HAS_CONSOLE=1 {command} >{shlex.quote(log)} 2>&1"
    spawn(command)

    address = ""
    window_class = ""
    deadline = time.monotonic() + args.wait
    while time.monotonic() < deadline and not address:
        time.sleep(0.4)
        for client in clients():
            if client["workspace"]["id"] != workspace:
                continue
            # A splash window (Orca's "Loading...") is mapped first and is gone by
            # the time anything can be driven, so a session that adopts it starts
            # every command against a window that no longer exists.
            if args.window_title and not fnmatch.fnmatch(
                    str(client.get("title", "")).lower(), args.window_title.lower()):
                continue
            address = client["address"]
            window_class = client.get("class", "")
            break
    if not address:
        print(f"cockpit: nothing appeared on workspace {workspace} within {args.wait:g}s")
        return 1

    if not args.no_fullscreen:
        hypr("dispatch", f'hl.dsp.window.fullscreen({{window="address:{address}"}})')
        time.sleep(0.35)

    # Qt swallows the click that activates a freshly mapped window, so the first
    # scripted click would only raise it. Focus once here instead.
    hypr("dispatch", f'hl.dsp.focus({{window="address:{address}"}})')
    time.sleep(0.5)

    state = {"app": args.app, "ws": workspace, "return_ws": here, "address": address,
             "class": window_class, "command": command, "log": log,
             "started": time.time()}
    save_state(args.app, state)
    window = main_window(state)

    if not args.no_activate_click:
        # See the module note: without this the first key of the session is lost.
        centre = to_global(window, window["size"][0] // 2, window["size"][1] // 2)
        move_cursor(*centre)
        time.sleep(0.1)
        device = Input()
        try:
            device.button("left", True)
            time.sleep(0.05)
            device.button("left", False)
        finally:
            device.close()
        time.sleep(0.2)
    print(f"cockpit: {args.app} on workspace {workspace}, window {window['size'][0]}x"
          f"{window['size'][1]} at {window['at'][0]},{window['at'][1]}")
    return 0


def wait_for_gone(state: dict, seconds: float) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if not any(client["workspace"]["id"] == state["ws"]
                   and client.get("class") == state.get("class") for client in clients()):
            return True
        time.sleep(0.2)
    return False


def press_key(app: str, name: str) -> None:
    args = argparse.Namespace(app=app, name=name, modifier=[], times=1, interval=0.05)
    with contextlib.redirect_stderr(io.StringIO()):
        try:
            cmd_key(args)
        except SystemExit:
            pass


def cmd_stop(args: argparse.Namespace) -> int:
    state = load_state(args.app)

    def open_windows() -> list[dict]:
        # Only ever close windows that belong to this app on this session's own
        # workspace: the addresses on disk can be stale, and closing a stale
        # address closes whatever now owns it.
        return app_windows(state["app"], state["ws"])

    # A preset editor is a separate top-level window and it blocks its parent, so
    # closing the main window first leaves the dialog holding the app open. Close
    # every window of the app, dialogs first (they are the smaller ones).
    windows = sorted(open_windows(), key=lambda client: client["size"][0] * client["size"][1])
    for client in windows:
        hypr("dispatch", f'hl.dsp.window.close({{window="address:{client["address"]}"}})')
        time.sleep(0.2)

    if windows:
        # The app refuses to close over unsaved work and asks what to do with it.
        # That guard is part of the app, so the tool has to answer it: poll for the
        # windows to go, and answer "Discard" the moment they do not -- nothing on
        # a test plate is worth keeping, and the guard would otherwise hold the
        # window open indefinitely.
        deadline = time.monotonic() + 8.0
        attempts = 0
        while time.monotonic() < deadline and open_windows():
            # The app asks "save this plate before closing?" when what is on the
            # plate is unsaved, and the second close request is the answer the app
            # documents as discard. Keys are tried too: they are free when the
            # guard is not up, and they are what a person would press.
            press_key(args.app, "d")
            attempts += 1
            if attempts >= 2:
                for client in open_windows():
                    hypr("dispatch",
                         f'hl.dsp.window.close({{window="address:{client["address"]}"}})')
            time.sleep(0.6)
        wait_for_gone(state, 1.5)
    still_open = open_windows()
    if still_open:
        # Keep the session: an open window the tool cannot close is still a
        # session, and dropping the record orphans it.
        titles = ", ".join(repr(client.get("title", "")) for client in still_open)
        print(f"cockpit: {args.app} is still open on workspace {state['ws']}: {titles}",
              file=sys.stderr)
        return 1

    os.unlink(state_path(args.app))
    if state.get("return_ws"):
        focus_workspace(state["return_ws"])
    print(f"cockpit: stopped {args.app}" if windows
          else f"cockpit: {args.app} was already gone; cleared the session")
    return 0


def cmd_status_args(_: argparse.Namespace) -> int:
    found = sessions()
    if not found:
        print("cockpit: no sessions")
        return 0
    for name, state in found.items():
        alive = any(client["address"] == state.get("address") for client in clients())
        print(f"{name}: workspace {state['ws']}, {'running' if alive else 'gone'}, "
              f"address {state.get('address')}")
    return 0


def cmd_log(args: argparse.Namespace) -> int:
    state = load_state(args.app)
    path = state.get("log") or log_path(args.app)
    if not os.path.exists(path):
        print(f"cockpit: no output captured for {args.app} at {path}", file=sys.stderr)
        return 1
    with open(path, encoding="utf-8", errors="replace") as handle:
        lines = handle.readlines()
    if args.lines > 0:
        lines = lines[-args.lines:]
    sys.stdout.write("".join(lines))
    return 0

def cmd_windows(args: argparse.Namespace) -> int:
    state = load_state(args.app)
    try:
        target = resolve_target(state, getattr(args, "window", None), announce=False)
    except SystemExit:
        target = None
    found = (app_windows(state["app"]) if args.all
             else app_windows(state["app"], state["ws"]))
    if args.json:
        print(json.dumps({
            "workspace": state["ws"],
            "target": target["address"] if target else None,
            "windows": [{"address": client["address"], "class": client.get("class", ""),
                         "title": client.get("title", ""), "at": client["at"],
                         "size": client["size"], "workspace": client["workspace"]["id"],
                         "target": bool(target and client["address"] == target["address"])}
                        for client in found]}, indent=2))
        return 0
    if not found:
        print(f"cockpit: no window for {state['app']!r} on workspace {state['ws']}")
        return 0
    for index, client in enumerate(found):
        marker = " <- target" if target and client["address"] == target["address"] else ""
        print(f"[{index}] {window_label(client)} workspace {client['workspace']['id']}{marker}")
    return 0


def cmd_window(args: argparse.Namespace) -> int:
    """Set, show or clear the session's remembered target window."""
    state = load_state(args.app)
    if args.clear:
        state.pop("target", None)
        state["reported"] = "main"
        save_state(state["app"], state)
        print("cockpit: target cleared; commands follow the main window")
        return 0
    if not args.spec:
        print(window_label(resolve_target(state, getattr(args, "window", None))))
        return 0
    target = resolve_target(state, args.spec, announce=False)
    remember_target(state, target)
    print(f"cockpit: target {window_label(target)}")
    return 0


def cmd_focus(args: argparse.Namespace) -> int:
    state = load_state(args.app)
    focus_workspace(state["ws"])
    time.sleep(0.15)
    target = resolve_target(state, getattr(args, "window", None))
    hypr("dispatch", f'hl.dsp.focus({{window="address:{target["address"]}"}})')
    return 0


def crop_to_window(png: str, target: dict) -> bool:
    """Crop a workspace capture down to one window, in place."""
    origin_x, origin_y = monitor_origin_of(target)
    x = target["at"][0] - origin_x
    y = target["at"][1] - origin_y
    width, height = target["size"]
    prepared = f"{png}.crop.png"
    result = subprocess.run(["magick", png, "-crop", f"{width}x{height}+{x}+{y}", "+repage",
                             prepared], capture_output=True, text=True)
    if result.returncode != 0:
        print(f"cockpit: crop to the window failed: {result.stderr.strip()}", file=sys.stderr)
        return False
    os.replace(prepared, png)
    return True


def cmd_shot(args: argparse.Namespace) -> int:
    state = load_state(args.app)
    target = resolve_target(state, getattr(args, "window", None))
    out = os.path.abspath(args.out)
    subprocess.run(["shot", "onws", str(state["ws"]), out, *args.grim], check=True,
                   capture_output=True)
    cropped = False if args.workspace_frame else crop_to_window(out, target)
    print(f"cockpit: {out} ({'workspace' if args.workspace_frame or not cropped else 'window'} "
          f"frame, {target.get('title', '')!r})")
    return 0


def cmd_move(args: argparse.Namespace) -> int:
    state = load_state(args.app)
    target = resolve_target(state, getattr(args, "window", None))
    point = to_global(target, args.x, args.y)
    # `hl.dsp.cursor.move` warps the cursor, and a warp produces no pointer event
    # for the client: Qt never learns the pointer arrived, so hover state, hover
    # fills and tooltips stay frozen where they were. Walking the pointer there
    # with the relative virtual device costs a few dozen events and makes hover
    # behave the way a hand does.
    if args.hover:
        # A warp gives the client no pointer event at all, so Qt keeps whatever
        # hover state it had: hover fills, hovers and tooltips stay frozen where
        # the pointer last *was*. A wheel event at the point does refresh it, and
        # one step each way leaves the content where it began. Relative motion
        # from the virtual device was tried first and did not: the client stayed
        # on the stale hover until a button event arrived.
        move_cursor(*point)
        time.sleep(0.12)
        pointer = Input()
        try:
            pointer.scroll(1)
            pointer.scroll(-1)
        finally:
            pointer.close()
        time.sleep(0.05)
        return 0
    move_cursor(*point)
    return 0


def capture(args: argparse.Namespace, target: dict | None = None) -> tuple[str, dict]:
    """Capture the session workspace and crop it to the target window.

    The target is resolved before the capture on purpose: `shot onws` switches
    the compositor to the session workspace to capture it, which moves focus, so
    a focused-window default read afterwards would name the wrong window.
    """
    state = load_state(args.app)
    if target is None:
        target = resolve_target(state, getattr(args, "window", None))
    out = os.path.join(STATE_DIR, f"{args.app}.png")
    os.makedirs(STATE_DIR, exist_ok=True)
    subprocess.run(["shot", "onws", str(state["ws"]), out], check=True,
                   capture_output=True)
    if not getattr(args, "workspace_frame", False):
        crop_to_window(out, target)
    return out, target


def _ocr_pass(png: str, scale: float, psm: str = "3") -> list[dict]:
    result = subprocess.run(["tesseract", png, "stdout", "tsv", "--psm", psm],
                            capture_output=True, text=True)
    words: list[dict] = []
    lines = result.stdout.splitlines()
    if not lines:
        return words
    header = lines[0].split("\t")
    for line in lines[1:]:
        fields = line.split("\t")
        if len(fields) != len(header):
            continue
        row = dict(zip(header, fields))
        text = row.get("text", "").strip()
        if not text or float(row.get("conf", 0)) < 0:
            continue
        words.append({"text": text,
                      "x": int(int(row["left"]) * scale), "y": int(int(row["top"]) * scale),
                      "w": int(int(row["width"]) * scale), "h": int(int(row["height"]) * scale),
                      "conf": float(row["conf"])})
    return words


def ocr_passes(png: str) -> list[list[dict]]:
    """OCR runs kept separate, best-suited first.

    Dark-theme text reads best raw; a reference app's light toolbar needs an
    inverted enlargement, and small glyphs need tesseract's sparse-text mode.
    Merging the runs would break line grouping, so they stay apart. Every run
    works on the window crop, which is small enough for four runs to be cheap;
    page-segmentation 3 is added to the pair the whole-screen version used, since
    a window with a toolbar, a notebook strip and a form is not one block.
    """
    passes = [_ocr_pass(png, 1.0, "3"), _ocr_pass(png, 1.0, "11")]
    prepared = os.path.join(STATE_DIR, "ocr-prepared.png")
    if prepare_ocr_image(png, prepared):
        passes.append(_ocr_pass(prepared, 0.4, "6"))
        passes.append(_ocr_pass(prepared, 0.4, "11"))
    return passes


def prepare_ocr_image(png: str, prepared: str) -> bool:
    """Grey, inverted, contrast-stretched, 250% -- what small light text needs."""
    if not shutil.which("magick"):
        return False
    result = subprocess.run(["magick", png, "-colorspace", "gray", "-negate",
                             "-auto-level", "-resize", "250%", prepared],
                            capture_output=True)
    return result.returncode == 0


def ocr_words(png: str) -> list[dict]:
    """Every word any pass saw, first sighting wins.

    The passes overlap, so the same word arrives up to four times with slightly
    different boxes; without this, `describe` lists every label as a duplicate.
    """
    words: list[dict] = []
    seen: set[tuple[str, int, int]] = set()
    for run in ocr_passes(png):
        for word in run:
            key = (word["text"].lower(), word["x"] // 12, word["y"] // 12)
            if key in seen:
                continue
            seen.add(key)
            words.append(word)
    return words


def best_matches(png: str, query: str) -> list[dict]:
    """Every match any OCR pass found, deduplicated.

    Returning the first pass that matched anything lost labels that only one pass
    can read: a wx notebook strip on a dark dialog comes out of the inverted
    enlargement, not the raw run, and asking for a tab then went unmatched while
    the same word inside a G-code field matched instead.
    """
    matches: list[dict] = []
    seen: set[tuple[str, int, int]] = set()
    for words in ocr_passes(png):
        for match in find_matches(words, query):
            key = (match["text"].lower(), match["x"] // 10, match["y"] // 10)
            if key in seen:
                continue
            seen.add(key)
            matches.append(match)
    return matches


def group_lines(words: list[dict]) -> list[list[dict]]:
    """OCR words grouped into visual lines.

    Tesseract reports a box per word in reading order, so a line group is words
    whose top edge is within a few pixels of the line's first word.
    """
    lines: list[list[dict]] = []
    for word in sorted(words, key=lambda item: (item["y"], item["x"])):
        if lines and abs(word["y"] - lines[-1][0]["y"]) <= 6:
            lines[-1].append(word)
        else:
            lines.append([word])
    for line in lines:
        line.sort(key=lambda item: item["x"])
    return lines


def find_matches(words: list[dict], query: str) -> list[dict]:
    """Locate a label on screen, tolerating the way OCR splits phrases into words.

    A query matches a run of consecutive words on one line once spaces are
    ignored, so "Slice plate" is found even though OCR reports two words.
    """
    lines = group_lines(words)

    wanted = "".join(query.lower().split())
    matches: list[dict] = []
    for line in lines:
        joined = "".join(word["text"].lower() for word in line)
        start = joined.find(wanted)
        while start >= 0:
            offset = 0
            chosen: list[dict] = []
            for word in line:
                end = offset + len(word["text"])
                if end > start and offset < start + len(wanted):
                    chosen.append(word)
                offset = end
            if chosen:
                matches.append(_box(chosen))
            start = joined.find(wanted, start + 1)

    if matches:
        return matches

    # OCR mangles small toolbar labels ("Slice plate" comes back as "sicepate"),
    # so fall back to the closest run of words on one line.
    best: tuple[float, list[dict]] | None = None
    for line in lines:
        for first in range(len(line)):
            for last in range(first, len(line)):
                candidate = "".join(word["text"].lower() for word in line[first:last + 1])
                ratio = difflib.SequenceMatcher(None, wanted, candidate).ratio()
                if ratio >= 0.7 and (best is None or ratio > best[0]):
                    best = (ratio, line[first:last + 1])
    if best is not None:
        return [_box(best[1], best[0])]
    return []


def normalise(text: str) -> str:
    """Lowercase, no spaces, no shortcut suffix: what two labels are compared on."""
    text = text.split("[")[0]
    return "".join(text.lower().split())


def _box(chosen: list[dict], ratio: float | None = None) -> dict:
    left = min(word["x"] for word in chosen)
    top = min(word["y"] for word in chosen)
    right = max(word["x"] + word["w"] for word in chosen)
    bottom = max(word["y"] + word["h"] for word in chosen)
    return {"text": " ".join(word["text"] for word in chosen), "x": left, "y": top,
            "w": right - left, "h": bottom - top,
            "conf": min(word["conf"] for word in chosen), "ratio": ratio}


def rank_matches(matches: list[dict], near: str | None) -> list[dict]:
    """Order matches by distance from a point, so `--index` is predictable."""
    if not matches or not near:
        return matches
    try:
        near_x, near_y = (float(part) for part in near.replace(" ", "").split(","))
    except ValueError:
        raise SystemExit(f"cockpit: --near wants X,Y in window pixels, not {near!r}")
    return sorted(matches, key=lambda match: (match_point(match)[0] - near_x) ** 2
                  + (match_point(match)[1] - near_y) ** 2)


def match_point(match: dict) -> tuple[int, int]:
    return int(match["x"] + match["w"] / 2), int(match["y"] + match["h"] / 2)


def frame_dict(target: dict) -> dict:
    return {"address": target["address"], "title": target.get("title", ""),
            "at": target["at"], "size": target["size"], "frame": "window"}


def closest_labels(png: str, query: str, limit: int = 8) -> list[str]:
    """The visible labels most similar to a query, for a failure message."""
    wanted = "".join(query.lower().split())
    scored: list[tuple[float, str]] = []
    for line in group_lines(ocr_words(png)):
        for first in range(len(line)):
            for last in range(first, min(first + 4, len(line))):
                text = " ".join(word["text"] for word in line[first:last + 1])
                ratio = difflib.SequenceMatcher(
                    None, wanted, "".join(text.lower().split())).ratio()
                if ratio >= 0.3:
                    scored.append((ratio, text))
    scored.sort(reverse=True)
    chosen: list[str] = []
    for _, text in scored:
        if text not in chosen:
            chosen.append(text)
        if len(chosen) >= limit:
            break
    return chosen


def report_want(png: str, target: dict, text: str, app: str) -> None:
    """Say what is visible, and what would make the missing label findable.

    This is the contract that replaces silence: a caller that cannot find a
    control must learn what the window does show and what to open instead.
    """
    print(f"cockpit: want {text!r} -- it is not in the target window "
          f"{target.get('title', '')!r}.", file=sys.stderr)
    closest = closest_labels(png, text)
    if closest:
        print("  closest visible labels: " + ", ".join(repr(label) for label in closest),
              file=sys.stderr)
    recorded = atlas_search(app, text, window_title=target.get("title", ""))
    if recorded:
        print(f"  the atlas has {recorded['text']!r} in window {recorded['window']!r} "
              f"at ({recorded['x']}, {recorded['y']}) -- `cockpit window "
              f"{recorded['window']!r}` then retry", file=sys.stderr)
    elif atlas_search(app, text):
        other = atlas_search(app, text)
        print(f"  the atlas has it in window {other['window']!r}, not this one -- "
              f"`cockpit windows --all`, then `cockpit window {other['window']!r}`",
              file=sys.stderr)
    else:
        print("  no atlas entry either: open the window or page that owns it "
              "(`cockpit windows --all`), then `cockpit window <title or address>`",
              file=sys.stderr)


def cmd_find_text(args: argparse.Namespace) -> int:
    png, target = capture(args)
    matches = rank_matches(best_matches(png, args.text), args.near)
    if args.json:
        print(json.dumps({"frame": frame_dict(target),
                          "matches": [dict(match, centre=match_point(match))
                                      for match in matches]}, indent=2))
        return 0 if matches else 1
    print(frame_header(target))
    if not matches:
        report_want(png, target, args.text, load_state(args.app)["app"])
        return 1
    for index, match in enumerate(matches):
        x, y = match_point(match)
        print(f"{index} {x} {y} {match['text']!r} conf {match['conf']:.0f}")
    return 0


def tooltip_at(args: argparse.Namespace, target: dict, x: float, y: float) -> str:
    """Hover a point and read the tooltip that appears under it, retrying the hover.

    A tooltip is a popup of its own, drawn above the window it belongs to, so it
    is not in the window crop: the workspace frame is captured and only the band
    under the pointer is OCR'd. The pointer is left where it landed, because
    moving it away dismisses the very thing the answer is about.

    wx does not show a tooltip on every dwell -- the timer sometimes misses the
    motion that started it -- so a miss is retried from a fresh approach rather
    than reported as "no tooltip".
    """
    attempts = getattr(args, "tries", 1)
    best = ""
    for _ in range(attempts):
        text = tooltip_once(args, target, x, y)
        if quality(text) > quality(best):
            best = text
        if quality(best) >= 6:
            break
    return best


def tooltip_once(args: argparse.Namespace, target: dict, x: float, y: float) -> str:
    state = load_state(args.app)
    # The tooltip only survives if the pointer is over a focused window when the
    # frame is taken, and `shot onws` *switches* to the session workspace when it
    # is not active: the app then re-enters, wx drops the tooltip, and the frame
    # shows nothing. Focusing first makes the capture a no-op switch.
    focus_workspace(state["ws"])
    time.sleep(0.2)
    global_x, global_y = to_global(target, x, y)
    # The pointer is walked into the control instead of warped onto it: a warp
    # sends the client no motion event, and a tooltip needs real motion over the
    # widget before its hover timer starts at all.
    move_cursor(global_x - 8, global_y - 8)
    time.sleep(0.1)
    pointer = Input()
    try:
        for _ in range(4):
            pointer.relative(2, 2)
            time.sleep(0.05)
    finally:
        pointer.close()
    out = os.path.join(STATE_DIR, f"{args.app}.png")
    os.makedirs(STATE_DIR, exist_ok=True)
    # One capture, after the hover has had time to mature: `shot onws` switches
    # workspace and back, which the app reads as the pointer leaving, so a
    # capture hides the tooltip and restarts its timer. Retrying in a loop is
    # therefore worse than waiting once.
    time.sleep(args.wait)
    subprocess.run(["shot", "onws", str(state["ws"]), out], check=True,
                   capture_output=True)
    ox, oy = monitor_origin_of(target)
    global_x, global_y = to_global(target, x, y)
    left = max(0, global_x - ox - 300)
    top = max(0, global_y - oy + (-46 if args.above else 4))
    crop = os.path.join(STATE_DIR, f"{args.app}-tip.png")
    subprocess.run(["magick", out, "-crop", f"900x56+{left}+{top}", "+repage", crop],
                   check=True, capture_output=True)
    # The tooltip's offset from the pointer is not fixed -- wx places it left or
    # right of the cursor depending on the widget -- but its background is far
    # darker than anything around it, so its box can be found instead of guessed:
    # threshold the band, negate and trim, and that box is the text.
    box = os.path.join(STATE_DIR, f"{args.app}-tipbox.png")
    trimmed = subprocess.run(["magick", crop, "-colorspace", "gray", "-threshold",
                              "15%", "-negate", "-trim", "+repage", box],
                             capture_output=True)
    text = tooltip_text(crop)
    if trimmed.returncode == 0:
        size = subprocess.run(["magick", "identify", "-format", "%w %h", box],
                              capture_output=True, text=True).stdout.split()
        if len(size) == 2 and 20 <= int(size[0]) <= 800 and 8 <= int(size[1]) <= 60:
            found = tooltip_text(box)
            if quality(found) > quality(text):
                text = found
    return text


def tooltip_text(png: str) -> str:
    """The tooltip line in a crop, or '' -- the longest line is the tooltip.

    The band under a pointer can also contain toolbar text or a label; a tooltip
    is the widest single run of words in it, and every tooltip this drives is one
    line long.
    """
    if not os.path.exists(png):
        return ""
    plain = os.path.join(STATE_DIR, "ocr-tip-plain.png")
    stretched = os.path.join(STATE_DIR, "ocr-tip-stretched.png")
    passes = [_ocr_pass(png, 1.0, "6"), _ocr_pass(png, 1.0, "7")]
    # A tooltip is light text on a small dark box inside a mostly uniform crop, and
    # `-auto-level` over that crop throws the glyph edges away: plain negate and
    # enlarge reads them, so both variants are tried and the best line wins.
    if shutil.which("magick"):
        if subprocess.run(["magick", png, "-colorspace", "gray", "-negate",
                           "-resize", "300%", plain],
                          capture_output=True).returncode == 0:
            passes.extend([_ocr_pass(plain, 1.0, "6"), _ocr_pass(plain, 1.0, "7")])
        if prepare_ocr_image(png, stretched):
            passes.extend([_ocr_pass(stretched, 0.4, "6"), _ocr_pass(stretched, 0.4, "7")])
    best = ""
    for words in passes:
        for line in words_by_row(words):
            text = " ".join(word["text"] for word in line).strip()
            if sum(character.isalpha() for character in text) < 3:
                continue
            if quality(text) > quality(best) or (quality(text) == quality(best)
                                                 and len(text) > len(best)):
                best = text
    return best


def words_by_row(words: list[dict], tolerance: int = 6) -> list[list[dict]]:
    """Words grouped into rows, tolerant enough to reunite a split label.

    Tesseract sometimes reports the two words of a tooltip as separate lines one
    pixel apart; a grouping that keys on exact baselines then answers with half
    the label, which reads as a wrong tooltip rather than an unreadable one.
    """
    rows: list[list[dict]] = []
    for word in sorted(words, key=lambda item: (item["y"], item["x"])):
        centre = word["y"] + word["h"] / 2
        for row in rows:
            anchor = row[0]["y"] + row[0]["h"] / 2
            if abs(anchor - centre) <= tolerance:
                row.append(word)
                break
        else:
            rows.append([word])
    return [sorted(row, key=lambda item: item["x"]) for row in rows]


def quality(text: str) -> float:
    """How much of a candidate looks like words rather than OCR noise."""
    if not text:
        return -1.0
    letters = sum(character.isalpha() for character in text)
    noise = sum(character in "\\_~^`'\"|<>{}[]" for character in text)
    return letters - 2 * noise


def cmd_tip(args: argparse.Namespace) -> int:
    target = resolve_target(load_state(args.app), getattr(args, "window", None))
    text = tooltip_at(args, target, args.x, args.y)
    if args.json:
        print(json.dumps({"frame": frame_dict(target), "x": args.x, "y": args.y,
                          "tip": text}, indent=2))
        return 0 if text else 1
    if not text:
        print(f"cockpit: no tooltip at {args.x},{args.y} in {window_label(target)} "
              f"after {args.wait:.1f}s", file=sys.stderr)
        return 1
    print(f"cockpit: tip {text!r} at {args.x},{args.y}")
    return 0


def cmd_tips(args: argparse.Namespace) -> int:
    """Sweep a row of controls and print what each one says it does."""
    target = resolve_target(load_state(args.app), getattr(args, "window", None))
    step = args.step
    x = args.start
    while (x <= args.end) if step > 0 else (x >= args.end):
        text = tooltip_at(args, target, x, args.row)
        print(f"{x:5.0f} {args.row:5.0f}  {text or '-'}")
        x += step
    return 0


def cmd_assert_tip(args: argparse.Namespace) -> int:
    target = resolve_target(load_state(args.app), getattr(args, "window", None))
    text = tooltip_at(args, target, args.x, args.y)
    if tip_matches(args.text, text):
        print(f"cockpit: tip {text!r} at {args.x},{args.y} matches {args.text!r}")
        return 0
    print(f"cockpit: want tooltip {args.text!r} at {args.x},{args.y}, got {text or 'nothing'!r}",
          file=sys.stderr)
    return 1


def tip_matches(wanted_text: str, observed: str) -> bool:
    """Whether a tooltip is the one that was asked for, allowing OCR damage.

    A tooltip is 11 px light-on-dark text and tesseract mangles single letters
    ("Boolean" comes back "Boolkean"), so a strict comparison fails on the right
    tooltip. The threshold is the one `find-text` already uses for the same
    reason; on strings this short a stricter ratio rejects correct answers.
    """
    wanted = normalise(wanted_text)
    seen = normalise(observed)
    if not wanted:
        return False
    if wanted in seen or seen in wanted:
        return True
    return difflib.SequenceMatcher(None, wanted, seen).ratio() >= 0.72


def cmd_ocr(args: argparse.Namespace) -> int:
    png, target = capture(args)
    words = sorted(ocr_words(png), key=lambda item: (item["y"], item["x"]))
    if args.json:
        print(json.dumps({"frame": frame_dict(target), "words": words}, indent=2))
        return 0 if words else 1
    print(frame_header(target))
    for word in words:
        print(f"{word['x']:4d} {word['y']:4d} {word['w']:3d} {word['h']:3d} "
              f"{word['conf']:5.0f} {word['text']}")
    return 0 if words else 1


def cmd_click_text(args: argparse.Namespace) -> int:
    state = load_state(args.app)
    target = resolve_target(state, getattr(args, "window", None))
    png, target = capture(args, target)
    matches = rank_matches(best_matches(png, args.text), args.near)
    if args.index < len(matches):
        match = matches[args.index]
        x, y = match_point(match)
        print(f"cockpit: clicking {match['text']!r} at ({x}, {y}) in "
              f"{target.get('title', '')!r}")
        return click_in(state, target, x, y, args.button, args.double, args.settle)
    if matches:
        print(f"cockpit: only {len(matches)} match(es) for {args.text!r}", file=sys.stderr)
        return 1
    if not args.no_atlas:
        recorded = atlas_lookup(state["app"], target, args.text)
        if recorded:
            print(f"cockpit: atlas {recorded['text']!r} at ({recorded['x']}, {recorded['y']}) "
                  f"in {target.get('title', '')!r} (recorded {recorded['updated']})")
            return click_in(state, target, recorded["x"], recorded["y"], args.button,
                            args.double, args.settle)
    report_want(png, target, args.text, state["app"])
    return 1


def cmd_click(args: argparse.Namespace) -> int:
    state = load_state(args.app)
    target = resolve_target(state, getattr(args, "window", None))
    return click_in(state, target, args.x, args.y, args.button, args.double, args.settle,
                    focus=not args.no_focus)


def click_in(state: dict, target: dict, x: float, y: float, button: str = "left",
             double: bool = False, settle: float = 0.08, focus: bool = True) -> int:
    """Press at a point in window pixels, in the target window.

    The last few pixels are walked with real pointer motion rather than warped.
    A warp sends the client no pointer event, and a wx control that only appears
    on hover (Orca's preset edit pencil) is then not there yet when the press
    arrives, so the press lands on the panel behind it and the click looks dead.
    """
    if focus:
        hypr("dispatch", f'hl.dsp.focus({{window="address:{target["address"]}"}})')
    screen_x, screen_y = to_global(target, x, y)
    move_cursor(screen_x - 40, screen_y - 6)
    device = Input()
    try:
        for _ in range(8):
            device.relative(5, 1)
            time.sleep(0.012)
        time.sleep(settle)
        for _ in range(2 if double else 1):
            device.button(button, True)
            time.sleep(0.02)
            device.button(button, False)
            time.sleep(0.06)
    finally:
        device.close()
    remember_target(state, target)
    return 0


def cmd_drag(args: argparse.Namespace) -> int:
    state = load_state(args.app)
    target = resolve_target(state, getattr(args, "window", None))
    start = to_global(target, args.x1, args.y1)
    end = to_global(target, args.x2, args.y2)
    hypr("dispatch", f'hl.dsp.focus({{window="address:{target["address"]}"}})')
    move_cursor(*start)
    time.sleep(args.settle)
    pointer = Input()
    # A modifier held for the whole drag is the only way to exercise Shift-drag
    # selection: a tap releases it before the pointer has moved.
    keyboard = Input("cockpit-keyboard", kind="keyboard") if args.hold else None
    try:
        if keyboard is not None:
            keyboard.key(MODIFIERS[args.hold[0]], 1)
            time.sleep(0.05)
        pointer.button(args.button, True)
        time.sleep(0.05)
        for step in range(1, args.steps + 1):
            x = start[0] + (end[0] - start[0]) * step // args.steps
            y = start[1] + (end[1] - start[1]) * step // args.steps
            move_cursor(x, y)
            time.sleep(args.step_delay)
        time.sleep(0.05)
        pointer.button(args.button, False)
    finally:
        if keyboard is not None:
            keyboard.key(MODIFIERS[args.hold[0]], 0)
            keyboard.close()
        pointer.close()
    return 0


def cmd_scroll(args: argparse.Namespace) -> int:
    state = load_state(args.app)
    target = resolve_target(state, getattr(args, "window", None))
    if args.x is not None and args.y is not None:
        hypr("dispatch", f'hl.dsp.focus({{window="address:{target["address"]}"}})')
        move_cursor(*to_global(target, args.x, args.y))
        time.sleep(0.05)
    device = Input()
    try:
        device.scroll(args.amount, args.horizontal)
    finally:
        device.close()
    return 0


def focus_session(state: dict, target: dict | None = None, focus: bool = True) -> dict:
    """Make the session's workspace active, then focus the target window."""
    if target is None:
        target = resolve_target(state, None)
    if focus:
        focus_workspace(state["ws"])
        time.sleep(0.15)
        hypr("dispatch", f'hl.dsp.focus({{window="address:{target["address"]}"}})')
    return target


def cmd_key(args: argparse.Namespace) -> int:
    state = load_state(args.app)
    focus_session(state, resolve_target(state, getattr(args, "window", None)),
                  focus=not getattr(args, "no_focus", False))
    time.sleep(0.05)
    names = key_names()
    alias = {"escape": "esc", "return": "enter", "del": "delete", "pgup": "pageup"}
    wanted = args.name.lower().lstrip("_")
    code = names.get(alias.get(wanted, wanted))
    if code is None:
        raise SystemExit(f"cockpit: unknown key {args.name!r} (try `cockpit keys | grep {args.name.lower()}`)")
    modifiers = [MODIFIERS[name] for name in args.modifier]
    device = Input("cockpit-keyboard", kind="keyboard")
    try:
        for _ in range(args.times):
            device.tap(code, modifiers)
            time.sleep(args.interval)
    finally:
        device.close()
    return 0


def cmd_type(args: argparse.Namespace) -> int:
    state = load_state(args.app)
    focus_session(state, resolve_target(state, getattr(args, "window", None)),
                  focus=not getattr(args, "no_focus", False))
    time.sleep(0.05)
    device = Input("cockpit-keyboard", kind="keyboard")
    try:
        for character in args.text:
            if character in SHIFTED:
                device.tap(SHIFTED[character], [MODIFIERS["shift"]])
            elif character in UNSHIFTED:
                device.tap(UNSHIFTED[character])
            elif character.isalpha():
                code = UNSHIFTED[character.lower()]
                device.tap(code, [MODIFIERS["shift"]] if character.isupper() else [])
            else:
                raise SystemExit(f"cockpit: cannot type {character!r}")
            time.sleep(args.interval)
    finally:
        device.close()
    return 0


def cmd_keys(_: argparse.Namespace) -> int:
    for name, code in sorted(key_names().items()):
        print(f"{name} {code}")
    return 0


# ------------------------------------------------------------------- atlas ---
# A per-app record of what was once on screen: window title -> page -> label ->
# window-relative box. Small wx labels OCR badly ("Slice plate" arrives as
# "sicepate") but they do not move, so one discovery run per window and page
# makes them clickable for good. It is a cache with provenance, never a
# substitute for a capture: a hit prints the date it was recorded.


def atlas_path(app: str) -> str:
    return os.path.join(ATLAS_DIR, f"{app}.json")


def load_atlas(app: str) -> dict:
    path = atlas_path(app)
    if not os.path.exists(path):
        return {"app": app, "windows": {}}
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def save_atlas(app: str, atlas: dict) -> None:
    os.makedirs(ATLAS_DIR, exist_ok=True)
    atlas["app"] = app
    atlas["updated"] = time.strftime("%Y-%m-%d")
    with open(atlas_path(app), "w", encoding="utf-8") as handle:
        json.dump(atlas, handle, indent=2, sort_keys=True)
        handle.write("\n")


def atlas_labels(atlas: dict, title: str, page: str) -> dict:
    window = atlas["windows"].setdefault(title, {"size": [0, 0], "pages": {}})
    return window["pages"].setdefault(page, {})


def atlas_scores(app: str, text: str) -> list[dict]:
    atlas = load_atlas(app)
    wanted = "".join(text.lower().split())
    found: list[dict] = []
    for title, window in atlas["windows"].items():
        for page, labels in window["pages"].items():
            for label, box in labels.items():
                ratio = difflib.SequenceMatcher(
                    None, wanted, "".join(label.lower().split())).ratio()
                if ratio < 0.7:
                    continue
                found.append({"text": label, "window": title, "page": page,
                              "x": box[0] + box[2] // 2, "y": box[1] + box[3] // 2,
                              "box": box, "ratio": round(ratio, 3),
                              "updated": atlas.get("updated", "earlier")})
    found.sort(key=lambda entry: entry["ratio"], reverse=True)
    return found


def atlas_search(app: str, text: str, window_title: str = "") -> dict | None:
    """Best atlas label for a query, preferring the window the caller is in."""
    for entry in atlas_scores(app, text):
        if window_title and entry["window"] == window_title:
            return entry
    scored = atlas_scores(app, text)
    return scored[0] if scored else None


def atlas_lookup(app: str, target: dict, text: str) -> dict | None:
    return atlas_search(app, text, window_title=target.get("title", ""))


def cmd_atlas(args: argparse.Namespace) -> int:
    state = load_state(args.app)
    atlas = load_atlas(state["app"])
    if args.action == "record":
        target = resolve_target(state, getattr(args, "window", None))
        png, target = capture(args, target)
        title = args.title or target.get("title", "").strip() or target["address"]
        page = args.page or "main"
        page_labels = atlas_labels(atlas, title, page)
        previous = len(page_labels)
        labels: dict = {}
        words = ocr_words(png)
        for word in words:
            labels[word["text"]] = [word["x"], word["y"], word["w"], word["h"]]
        # A label is usually several words ("Basic information", "Emit limits to
        # G-code"), and a query is written the way it reads, so runs of up to
        # three words are stored beside the single words. A whole line is never
        # stored as one label: on a tab strip that box spans every tab, and its
        # centre is the wrong tab.
        for line in group_lines(words):
            for start in range(len(line)):
                for length in range(2, 4):
                    run = line[start:start + length]
                    if len(run) < length:
                        break
                    text = " ".join(word["text"] for word in run)
                    left = min(word["x"] for word in run)
                    top = min(word["y"] for word in run)
                    right = max(word["x"] + word["w"] for word in run)
                    bottom = max(word["y"] + word["h"] for word in run)
                    labels.setdefault(text, [left, top, right - left, bottom - top])
        atlas["windows"][title]["pages"][page] = labels
        atlas["windows"][title]["size"] = list(target["size"])
        save_atlas(state["app"], atlas)
        print(f"cockpit: atlas {state['app']!r} window {title!r} page {page!r}: "
              f"{len(labels)} label(s) from {len(words)} word(s), replacing {previous} "
              f"-> {atlas_path(state['app'])}")
        return 0
    if args.action == "show":
        if not atlas["windows"]:
            print(f"cockpit: no atlas for {state['app']!r} yet "
                  f"(`cockpit atlas record` in the window it should learn)")
            return 0
        for title, window in sorted(atlas["windows"].items()):
            if args.title and args.title.lower() not in title.lower():
                continue
            print(f"{title!r} {window['size'][0]}x{window['size'][1]}")
            for page, labels in sorted(window["pages"].items()):
                if args.page and page != args.page:
                    continue
                print(f"  page {page!r}: {len(labels)} label(s)")
                if args.labels:
                    for label, box in sorted(labels.items()):
                        print(f"    {box[0]:4d} {box[1]:4d} {box[2]:3d} {box[3]:3d} {label}")
        print(f"recorded {atlas.get('updated', 'earlier')} in {atlas_path(state['app'])}")
        return 0
    if not args.text:
        raise SystemExit("cockpit: `atlas find` wants a label to look for")
    hits = [entry for entry in atlas_scores(state["app"], args.text)
            if not args.title or args.title.lower() in entry["window"].lower()]
    if not hits:
        print(f"cockpit: the atlas has nothing like {args.text!r} -- "
              f"`cockpit atlas record` after finding it by eye", file=sys.stderr)
        return 1
    for entry in hits[:10]:
        print(f"{entry['ratio']:.2f} {entry['window']!r} page {entry['page']!r} "
              f"{entry['text']!r} at ({entry['x']}, {entry['y']})")
    return 0


