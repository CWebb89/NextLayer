def cmd_describe(args: argparse.Namespace) -> int:
    """Everything the tool can see: windows, target, and every readable label."""
    state = load_state(args.app)
    main = main_window(state)
    target = resolve_target(state, getattr(args, "window", None))
    print(f"cockpit: {state['app']!r} on workspace {state['ws']}")
    print(f"main window: {window_label(main)}")
    for index, client in enumerate(app_windows(state["app"])):
        marker = " <- target" if client["address"] == target["address"] else ""
        print(f"  [{index}] {window_label(client)} workspace "
              f"{client['workspace']['id']}{marker}")
    png, target = capture(args, target)
    words = sorted(ocr_words(png), key=lambda item: (item["y"], item["x"]))
    print(frame_header(target))
    print(f"{len(words)} readable label(s):")
    for word in words:
        print(f"  {word['x']:4d} {word['y']:4d} {word['w']:3d} {word['h']:3d} "
              f"{word['conf']:5.0f} {word['text']}")
    if not words:
        print("nothing readable -- the window may be blank, covered, or still drawing")
    return 0


def cmd_want(args: argparse.Namespace) -> int:
    """Answer "is this on screen, and if not, what would make it appear"."""
    state = load_state(args.app)
    target = resolve_target(state, getattr(args, "window", None))
    png, target = capture(args, target)
    matches = best_matches(png, args.text)
    if matches:
        x, y = match_point(matches[0])
        print(f"cockpit: {matches[0]['text']!r} is visible at ({x}, {y}) in "
              f"{target.get('title', '')!r}")
        return 0
    report_want(png, target, args.text, state["app"])
    return 1


def wait_for_text(args: argparse.Namespace) -> bool:
    deadline = time.monotonic() + args.timeout
    while True:
        png, target = capture(args)
        matches = best_matches(png, args.text)
        if matches:
            x, y = match_point(matches[0])
            print(f"cockpit: found {matches[0]['text']!r} at ({x}, {y}) in "
                  f"{target.get('title', '')!r}")
            return True
        if time.monotonic() >= deadline:
            report_want(png, target, args.text, load_state(args.app)["app"])
            return False
        time.sleep(args.interval)


def wait_for_window(args: argparse.Namespace) -> bool:
    deadline = time.monotonic() + args.timeout
    pattern = args.pattern.lower()
    while True:
        state = load_state(args.app)
        candidates = app_windows(state["app"])
        for client in candidates:
            title = str(client.get("title", "")).lower()
            if fnmatch.fnmatch(title, pattern) or pattern in title:
                print(f"cockpit: window {window_label(client)} matches {args.pattern!r}")
                remember_target(state, client)
                return True
        if time.monotonic() >= deadline:
            titles = ", ".join(repr(client.get("title", "")) for client in candidates)
            print(f"cockpit: want window {args.pattern!r} -- open windows are: "
                  f"{titles or 'none'}", file=sys.stderr)
            return False
        time.sleep(args.interval)


def cmd_assert_text(args: argparse.Namespace) -> int:
    return 0 if wait_for_text(args) else 1


def cmd_assert_window(args: argparse.Namespace) -> int:
    return 0 if wait_for_window(args) else 1


def cmd_run(args: argparse.Namespace) -> int:
    if args.app is None:
        raise SystemExit("cockpit: `run` needs --app when more than one session is running")
    if not os.path.exists(args.script):
        raise SystemExit(f"cockpit: no script at {args.script}")
    with open(args.script, encoding="utf-8") as handle:
        lines = [line.split("#", 1)[0].strip() for line in handle]
    for number, line in enumerate(lines, 1):
        if not line:
            continue
        print(f"cockpit run {number}: {line}")
        words = shlex.split(line)
        # `try` is for the steps that clean up an environment's own mess -- a
        # startup dialog this app raises about a file it cannot find, say. The
        # step still prints, so it is never hidden; only its failure is forgiven,
        # because a drive that aborts on an absent dialog is a drive that fails
        # the gate for a reason that has nothing to do with the app under test.
        forgive = words[0] == "try"
        if forgive:
            words = words[1:]
        if words[0] == "sleep":
            time.sleep(float(words[1]))
            continue
        try:
            status = main(["--app", args.app, *words], nested=True)
        except SystemExit as exit_request:
            status = exit_request.code if isinstance(exit_request.code, int) else 1
        if status != 0:
            if forgive:
                continue
            print(f"cockpit: script stopped at line {number}: {line}")
            return 1
    return 0


