def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="cockpit", description=__doc__.splitlines()[0])
    parser.add_argument("--app", help="session name (defaults to the only running one)")
    parser.add_argument("--window", default=None,
                        help="target window: address prefix, title glob or index")
    subparsers = parser.add_subparsers(dest="command", required=True)

    start = subparsers.add_parser("start", help="launch the app alone on an unused workspace")
    start.add_argument("app")
    start.add_argument("--command", default=None, help="binary to run (default: the app name)")
    start.add_argument("--model", help="model file passed as the first argument")
    start.add_argument("--arg", action="append", default=[],
                       help="extra argument passed before the model (repeatable)")
    start.add_argument("--workspace", type=int, help="use this workspace instead of a free one")
    start.add_argument("--wait", type=float, default=25.0, help="seconds to wait for a window")
    start.add_argument("--window-title", default=None,
                       help="wait for a window whose title matches this glob")
    start.add_argument("--no-fullscreen", action="store_true")
    start.add_argument("--no-activate-click", action="store_true",
                       help="do not click once to activate the window (keys will not arrive)")
    start.set_defaults(func=cmd_start)

    stop = subparsers.add_parser("stop", help="close the app and drop the session")
    stop.set_defaults(func=cmd_stop)

    status = subparsers.add_parser("status", help="list sessions")
    status.set_defaults(func=cmd_status_args)

    log = subparsers.add_parser("log", help="print what the app wrote to stdout and stderr")
    log.add_argument("--lines", type=int, default=100,
                     help="how many trailing lines to print (0 for all)")
    log.set_defaults(func=cmd_log)

    windows = subparsers.add_parser("windows", help="list the app's windows and the target")
    windows.add_argument("--all", action="store_true",
                         help="every window of the app, on any workspace")
    windows.add_argument("--json", action="store_true")
    windows.set_defaults(func=cmd_windows)

    window = subparsers.add_parser("window", help="set, show or clear the target window")
    window.add_argument("spec", nargs="?",
                        help="address prefix, title glob or index from `cockpit windows`")
    window.add_argument("--clear", action="store_true", help="go back to the main window")
    window.set_defaults(func=cmd_window)

    focus = subparsers.add_parser("focus", help="focus the app's window and workspace")
    focus.set_defaults(func=cmd_focus)

    shot = subparsers.add_parser("shot", help="capture the target window to a PNG")
    shot.add_argument("out")
    shot.add_argument("--workspace-frame", action="store_true",
                      help="capture the whole workspace instead of cropping to the window")
    shot.add_argument("grim", nargs="*", help="extra arguments for grim")
    shot.set_defaults(func=cmd_shot)

    move = subparsers.add_parser("move", help="move the pointer (window pixels)")
    move.add_argument("x", type=float)
    move.add_argument("y", type=float)
    move.add_argument("--hover", action="store_true",
                      help="walk the pointer there with real motion, so hover state updates")
    move.set_defaults(func=cmd_move)

    click = subparsers.add_parser("click", help="click a point (window pixels)")
    click.add_argument("x", type=float)
    click.add_argument("y", type=float)
    click.add_argument("--button", default="left", choices=sorted(BUTTONS))
    click.add_argument("--double", action="store_true")
    click.add_argument("--settle", type=float, default=0.08)
    click.add_argument("--no-focus", action="store_true",
                       help="do not focus the window first (keeps an open menu alive)")
    click.set_defaults(func=cmd_click)

    drag = subparsers.add_parser("drag", help="press, move, release between two points")
    drag.add_argument("x1", type=float)
    drag.add_argument("y1", type=float)
    drag.add_argument("x2", type=float)
    drag.add_argument("y2", type=float)
    drag.add_argument("--button", default="left", choices=sorted(BUTTONS))
    drag.add_argument("--steps", type=int, default=12)
    drag.add_argument("--settle", type=float, default=0.08)
    drag.add_argument("--step-delay", type=float, default=0.02)
    drag.add_argument("--hold", action="append", default=[], choices=sorted(MODIFIERS),
                       help="modifier held down for the whole drag (repeatable)")
    drag.set_defaults(func=cmd_drag)

    scroll = subparsers.add_parser("scroll", help="scroll the wheel (positive is up)")
    scroll.add_argument("amount", type=int)
    scroll.add_argument("--x", type=float)
    scroll.add_argument("--y", type=float)
    scroll.add_argument("--horizontal", action="store_true")
    scroll.set_defaults(func=cmd_scroll)

    key = subparsers.add_parser("key", help="press a key by its KEY_<NAME> name")
    key.add_argument("name")
    key.add_argument("--modifier", action="append", default=[], choices=sorted(MODIFIERS))
    key.add_argument("--times", type=int, default=1)
    key.add_argument("--interval", type=float, default=0.05)
    key.add_argument("--no-focus", action="store_true",
                     help="do not focus the window first (a menu already has the keys)")
    key.set_defaults(func=cmd_key)

    keys = subparsers.add_parser("keys", help="list known key names")
    keys.set_defaults(func=cmd_keys)

    ocr = subparsers.add_parser("ocr", help="list every word on screen with its position")
    ocr.add_argument("--json", action="store_true", help="boxes as JSON, with the frame")
    ocr.set_defaults(func=cmd_ocr)

    tip = subparsers.add_parser("tip", help="hover a control and read its tooltip")
    tip.add_argument("x", type=float)
    tip.add_argument("y", type=float)
    tip.add_argument("--wait", type=float, default=3.0,
                     help="seconds to keep hovering before giving up")
    tip.add_argument("--above", action="store_true",
                     help="the tooltip opens above the pointer")
    tip.add_argument("--tries", type=int, default=3,
                     help="how many times to hover before giving up")
    tip.add_argument("--json", action="store_true")
    tip.set_defaults(func=cmd_tip)

    tips = subparsers.add_parser("tips", help="sweep a row of controls, one tooltip each")
    tips.add_argument("--row", type=float, required=True)
    tips.add_argument("--from", dest="start", type=float, required=True)
    tips.add_argument("--to", dest="end", type=float, required=True)
    tips.add_argument("--step", type=float, default=32.0)
    tips.add_argument("--wait", type=float, default=1.6)
    tips.add_argument("--above", action="store_true")
    tips.add_argument("--tries", type=int, default=2)
    tips.set_defaults(func=cmd_tips)

    assert_tip = subparsers.add_parser("assert-tip",
                                       help="fail unless a control's tooltip says this")
    assert_tip.add_argument("x", type=float)
    assert_tip.add_argument("y", type=float)
    assert_tip.add_argument("text")
    assert_tip.add_argument("--wait", type=float, default=3.0)
    assert_tip.add_argument("--above", action="store_true")
    assert_tip.add_argument("--tries", type=int, default=3)
    assert_tip.set_defaults(func=cmd_assert_tip)

    find_text = subparsers.add_parser("find-text", help="locate text on screen")
    find_text.add_argument("text")
    find_text.add_argument("--near", help="order matches by distance from X,Y")
    find_text.add_argument("--json", action="store_true")
    find_text.set_defaults(func=cmd_find_text)

    click_text = subparsers.add_parser("click-text", help="click a label found on screen")
    click_text.add_argument("text")
    click_text.add_argument("--index", type=int, default=0)
    click_text.add_argument("--near", help="order matches by distance from X,Y")
    click_text.add_argument("--no-atlas", action="store_true",
                            help="do not fall back to a recorded atlas label")
    click_text.add_argument("--button", default="left", choices=sorted(BUTTONS))
    click_text.add_argument("--double", action="store_true")
    click_text.add_argument("--settle", type=float, default=0.08)
    click_text.set_defaults(func=cmd_click_text)

    describe = subparsers.add_parser("describe", help="windows, target and every readable label")
    describe.set_defaults(func=cmd_describe)

    want = subparsers.add_parser("want", help="is this label on screen, and what would show it")
    want.add_argument("text")
    want.set_defaults(func=cmd_want)

    atlas = subparsers.add_parser("atlas", help="the per-app record of controls and where they sit")
    atlas.add_argument("action", choices=["record", "show", "find"])
    atlas.add_argument("text", nargs="?", help="label to look for (`find`)")
    atlas.add_argument("--title", help="store/look up under this window title")
    atlas.add_argument("--page", help="store/look up under this page or tab")
    atlas.add_argument("--labels", action="store_true", help="`show` prints every label")
    atlas.set_defaults(func=cmd_atlas)

    assert_text = subparsers.add_parser("assert-text", help="fail unless a label is on screen")
    assert_text.add_argument("text")
    assert_text.add_argument("--timeout", type=float, default=0.0)
    assert_text.add_argument("--interval", type=float, default=0.5)
    assert_text.set_defaults(func=cmd_assert_text)

    wait_text = subparsers.add_parser("wait-text", help="wait for a label to appear")
    wait_text.add_argument("text")
    wait_text.add_argument("--timeout", type=float, default=10.0)
    wait_text.add_argument("--interval", type=float, default=0.5)
    wait_text.set_defaults(func=cmd_assert_text)

    assert_window = subparsers.add_parser("assert-window", help="fail unless a window exists")
    assert_window.add_argument("pattern")
    assert_window.add_argument("--timeout", type=float, default=0.0)
    assert_window.add_argument("--interval", type=float, default=0.5)
    assert_window.set_defaults(func=cmd_assert_window)

    wait_window = subparsers.add_parser("wait-window", help="wait for a window to appear")
    wait_window.add_argument("pattern")
    wait_window.add_argument("--timeout", type=float, default=10.0)
    wait_window.add_argument("--interval", type=float, default=0.5)
    wait_window.set_defaults(func=cmd_assert_window)

    type_command = subparsers.add_parser("type", help="type text (US layout)")
    type_command.add_argument("text")
    type_command.add_argument("--interval", type=float, default=0.01)
    type_command.add_argument("--no-focus", action="store_true")
    type_command.set_defaults(func=cmd_type)

    run = subparsers.add_parser("run", help="run a file of cockpit commands")
    run.add_argument("script")
    run.set_defaults(func=cmd_run)

    # `--window` is accepted after the subcommand as well as before it, and the
    # subcommand's copy is suppressed so it never overwrites the global one.
    for subparser in subparsers.choices.values():
        subparser.add_argument("--window", default=argparse.SUPPRESS,
                               help="target window: address prefix, title glob or index")
        subparser.add_argument("--app", default=argparse.SUPPRESS,
                               help="session name (defaults to the only running one)")

    return parser


def main(argv: list[str] | None = None, nested: bool = False) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not nested and getattr(args, "func", None) is not cmd_start and args.app is None:
        running = sessions()
        if len(running) == 1:
            args.app = next(iter(running))
    try:
        return args.func(args)
    except RuntimeError as error:
        print(f"cockpit: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
