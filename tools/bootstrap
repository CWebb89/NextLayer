#!/usr/bin/env fish
# Fetches the slicing engine next-layer links, at the commit it was last verified
# against, and applies the patches in patches/ in name order.
#
#   tools/bootstrap            prepare upstream/ to a buildable state
#   tools/bootstrap --status   report what is there, change nothing
#
# The engine tree is a dependency, not a place to keep work: this script refuses
# to touch it while it has uncommitted changes. Everything of ours lives in this
# repository, outside upstream/.

set -l root (realpath (dirname (status filename))/..)
set -l checkout $root/upstream
set -l patches $root/patches/*.patch
set -l engine_repo https://github.com/prusa3d/PrusaSlicer.git
set -l engine_commit 30ef59195e0f3ee6f270b185bb5f9fb5f349f81f

set -l status_only 0
for arg in $argv
    switch $arg
        case --status
            set status_only 1
        case -h --help
            printf '%s\n' 'usage: tools/bootstrap [--status]'
            exit 0
        case '*'
            echo "tools/bootstrap: unknown argument: $arg" >&2
            exit 2
    end
end

if test (count $patches) -eq 0
    echo "tools/bootstrap: no patches in $root/patches" >&2
    exit 1
end
for patch in $patches
    if not test -f $patch
        echo "tools/bootstrap: $patch is missing" >&2
        exit 1
    end
end

function __report --argument-names checkout commit
    set -l head (git -C $checkout rev-parse HEAD 2>/dev/null)
    set -l parent (git -C $checkout rev-parse HEAD^ 2>/dev/null)
    if test "$head" = "$commit"
        echo "engine: pinned commit, patch not applied"
    else if test "$parent" = "$commit"
        echo "engine: pinned commit + our patch, ready"
    else
        echo "engine: $head (expected $commit plus our patch)"
    end
end

if test $status_only -eq 1
    if not test -d $checkout/.git
        echo "engine: not fetched"
        exit 1
    end
    __report $checkout $engine_commit
    if test -n "$(git -C $checkout status --porcelain 2>/dev/null)"
        echo "engine: has uncommitted changes"
        exit 1
    end
    exit 0
end

if test -d $checkout/.git
    if test -n "$(git -C $checkout status --porcelain 2>/dev/null)"
        echo "tools/bootstrap: $checkout has uncommitted changes; commit or discard them first" >&2
        exit 1
    end
else
    if test -e $checkout
        echo "tools/bootstrap: $checkout exists but is not a git checkout" >&2
        exit 1
    end
    echo "fetching the engine at $engine_commit"
    git init -q $checkout; or exit 1
    git -C $checkout remote add origin $engine_repo; or exit 1
    git -C $checkout fetch -q --depth 1 origin $engine_commit; or exit 1
end

if not git -C $checkout rev-parse -q --verify "$engine_commit^{commit}" >/dev/null
    echo "fetching the pinned commit"
    git -C $checkout fetch -q --depth 1 origin $engine_commit; or exit 1
end

set -l parent (git -C $checkout rev-parse HEAD^ 2>/dev/null)
set -l head (git -C $checkout rev-parse HEAD 2>/dev/null)

if test "$parent" = "$engine_commit"
    echo "engine already bootstrapped at $engine_commit"
    exit 0
end

if test "$head" != "$engine_commit"
    git -C $checkout checkout -q -B engine $engine_commit; or exit 1
end

for patch in $patches
    if not git -C $checkout apply --index $patch
        echo "tools/bootstrap: $(basename $patch) does not apply to $engine_commit" >&2
        echo "re-export patches/ against the new commit" >&2
        exit 1
    end
end
if not git -C $checkout commit -q -m 'build: build the next-layer app from outside the engine tree'
    echo "tools/bootstrap: could not commit the applied patches" >&2
    exit 1
end

echo "engine bootstrapped at $engine_commit with our patches"
echo
echo "next, build it (the first configure fetches the engine's dependencies and"
echo "takes hours; a memory-capped scope is required on this machine):"
echo
echo "  cmake -S $checkout -B $checkout/build -DCMAKE_BUILD_TYPE=Release"
echo "  cmake --build $checkout/build --target next-layer-qt -j4"
