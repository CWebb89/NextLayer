#!/usr/bin/env fish
# Shows what is uncommitted and what state the engine checkout is in, without
# changing anything.
#
#   tools/status

set -l root (realpath (dirname (status filename))/..)

echo "== this repository  ($root)"
set -l branch (git -C $root symbolic-ref --short --quiet HEAD)
set -l head (git -C $root log --oneline -1)
if test -z "$branch"
    echo "   HEAD detached at: $head"
else
    echo "   branch $branch: $head"
end

set -l unmerged (git -C $root ls-files --unmerged | wc -l)
if test $unmerged -gt 0
    echo "   MID-MERGE: $unmerged unmerged path(s)"
end

set -l changed (git -C $root status --porcelain | count)
if test $changed -eq 0
    echo '   clean'
else
    echo "   $changed changed file(s):"
    git -C $root status --short | head -n 40 | sed 's/^/     /'
    if test $changed -gt 40
        echo "     ... and "(math $changed - 40)" more"
    end
end
echo

echo '== engine checkout  (upstream/)'
$root/tools/bootstrap --status
set -l engine_rc $status
if test $engine_rc -ne 0
    echo '   run tools/bootstrap to fetch and patch it'
end

exit 0
