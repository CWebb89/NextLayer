#!/usr/bin/env fish
# Saves work with one message, in one repository.
#
#   tools/save "what changed"
#
# Everything tracked here is ours. The engine checkout under upstream/ is a
# dependency and is ignored, so it cannot be committed by accident. Never
# pushes, never resets, never touches history.

set -l root (realpath (dirname (status filename))/..)

if test (count $argv) -lt 1
    echo 'usage: tools/save "what changed"' >&2
    exit 2
end

set -l message (string join ' ' -- $argv)

echo "saving: $message"

if string length -q -- (git -C $root ls-files --unmerged | head -n 1)
    echo '  mid-merge: resolve it, then save' >&2
    exit 1
end

if not string length -q -- (git -C $root status --porcelain | head -n 1)
    echo 'nothing to save'
    exit 0
end

git -C $root add -A
set -l staged (git -C $root diff --cached --name-only | count)
if not git -C $root commit -q -m "$message"
    echo '  commit FAILED' >&2
    exit 1
end

echo "  committed $staged file(s)"
