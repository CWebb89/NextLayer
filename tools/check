#!/usr/bin/env fish
# One command that answers "is this still good?".
#
#   tools/check                 everything, ~1 minute
#   tools/check --fast          skip the oracle (the slow, byte-exact half)
#   tools/check --ui            also open a real window, click, and capture it
#   tools/check --update-qmllint-baseline
#                               accept the current qmllint warnings as known
#
# Every gate reads its verdict out of the tool's own output rather than its exit
# code alone: a coverage figure, a setting count, a match count, a layer count.
# A gate that cannot measure its subject fails.
#
# Nothing here builds. A binary older than its sources fails the first gate and
# names the files, because a green run against a stale binary is a lie.

set -l root (realpath (dirname (status filename))/..)
set -l bin $root/upstream/build/src/slic3r-app-qt/next-layer-qt
set -l model $root/oracle/models/cube_20.stl
set -l qml $root/upstream/src/slic3r-app-qt/qml
set -l code $root/upstream/src/slic3r-app-qt/src
set -l spike $root/upstream/src/slic3r-app-spike
set -l baseline $root/tools/qmllint-baseline

set -g passed 0
set -g failed 0
set -g failures

set -l fast 0
set -l ui 0
set -l update 0

for arg in $argv
    switch $arg
        case --fast
            set fast 1
        case --ui
            set ui 1
        case --update-qmllint-baseline
            set update 1
        case -h --help
            printf '%s\n' \
                'usage: tools/check [--fast] [--ui] [--update-qmllint-baseline]' \
                '' \
                '  --fast                      skip oracle verify (the slow, byte-exact check)' \
                '  --ui                        also drive a real window and capture it' \
                '  --update-qmllint-baseline   accept the current qmllint warnings as known' \
                '' \
                'Run this after any change. It does not build: build first, then check.'
            exit 0
        case '*'
            echo "tools/check: unknown argument: $arg" >&2
            exit 2
    end
end

function __ok --argument-names text
    printf '  ok    %s\n' $text
    set -g passed (math $passed + 1)
end

function __bad --argument-names text
    printf '  FAIL  %s\n' $text
    set -g failed (math $failed + 1)
    set -g failures $failures $text
end

function __skip --argument-names text
    printf '  skip  %s\n' $text
end

echo 'next-layer check'

set -l ready 1
if not test -x $bin
    __bad "no binary at $bin — build it first"
    set ready 0
else
    # QML is loaded from disk at runtime, so it is never stale with respect to the
    # binary -- only what is compiled in can be. QML gets its own gates below
    # (qmllint) and, with --ui, a real window.
    set -l newer (find $code $spike -type f -newer $bin -not -path '*/.git/*' 2>/dev/null)
    if test (count $newer) -gt 0
        __bad "binary is stale: "(count $newer)" source file(s) newer than it, e.g. "(string join ' ' (path basename -- $newer[1..3]))
        set ready 0
    else
        __ok 'binary is current'
    end
end

if test $ready -eq 0
    echo
    echo 'not running the rest: the binary cannot be trusted'
    exit 1
end

pushd $root/upstream/src/slic3r-app-qt >/dev/null
set -l qmlfiles (find qml -name '*.qml')
set -l lint (qmllint --unqualified disable $qmlfiles 2>&1)
popd >/dev/null
set -l warnings (string match --entire --regex '^Warning: ' -- $lint)

set -l keys
for line in $warnings
    set -l code_match (string match -r '\[([A-Za-z0-9._-]+)\]\s*$' -- $line)
    set -l file_match (string match -r '^Warning: ([^ :]+\.qml)' -- $line)
    set -l key 'no-file'
    if set -q file_match[2]
        set key $file_match[2]
    end
    set -l category unknown
    if set -q code_match[2]
        set category $code_match[2]
    end
    set -a keys "$key::$category"
end

set -l actual
if test (count $keys) -gt 0
    set actual (printf '%s\n' $keys | sort -u)
end

if test $update -eq 1
    printf '%s\n' '# qmllint warnings that are known and accepted, as <file>::<category>.' \
        '# [unqualified] is disabled in tools/check: the QML reads C++ context' \
        '# properties that qmllint cannot resolve. Regenerate with' \
        '#   tools/check --update-qmllint-baseline' >$baseline
    if test (count $actual) -gt 0
        printf '%s\n' $actual >>$baseline
    end
    __ok "qmllint baseline rewritten: "(count $actual)" known warning kind(s)"
else if not test -f $baseline
    __bad "no qmllint baseline at $baseline — create it with tools/check --update-qmllint-baseline"
else
    set -l expected (grep -v -e '^#' -e '^$' $baseline | sort -u)
    set -l new_kinds
    for key in $actual
        if not contains -- $key $expected
            set -a new_kinds $key
        end
    end
    set -l gone
    for key in $expected
        if not contains -- $key $actual
            set -a gone $key
        end
    end
    if test (count $new_kinds) -gt 0
        __bad "qmllint: "(count $warnings)" warning(s), "(count $new_kinds)" new kind(s): "(string join ', ' $new_kinds)
    else if test (count $gone) -gt 0
        __ok "qmllint: "(count $warnings)" warning(s), no new kinds ("(count $gone)" listed kind(s) gone, prune the baseline)"
    else
        __ok "qmllint: "(count $warnings)" warning(s), all known"
    end
end

set -l tabs_out ($bin $model --dump-tabs 2>&1)
set -l tabs_rc $status
set -l tally (printf '%s\n' $tabs_out | awk '
    /^[a-z]+ ".*": [0-9]+ sub-tabs, [0-9]+ settings$/ {
        tabs++
        split($0, field, ", ")
        sub(/ settings$/, "", field[2])
        sum += field[2]
    }
    /^total: / { gsub(/[^0-9]/, ""); total = $0 }
    END { print tabs + 0, sum + 0, total + 0 }')
set -l tally_parts (string split ' ' -- $tally)
set -l tab_count $tally_parts[1]
set -l tab_sum $tally_parts[2]
set -l tab_total $tally_parts[3]
if test $tabs_rc -ne 0
    __bad "--dump-tabs exited $tabs_rc"
else if test $tab_count -ne 3
    __bad "settings tabs: expected 3, saw $tab_count"
else if test $tab_sum -ne $tab_total
    __bad "settings count does not add up: sub-tabs sum to $tab_sum, total says $tab_total"
else if test $tab_total -lt 300
    __bad "settings model lost settings: $tab_total (expected at least 300)"
else
    __ok "settings: $tab_count tabs, $tab_total settings"
end

set -l font_out ($bin --dump-fonts 2>&1)
set -l font_rc $status
set -l font_count (string match -r '^fonts: (\d+) openable$' -- $font_out)
set -l font_metrics (string match -r '^metrics: .*unit_per_em (\d+)$' -- $font_out)
if test $font_rc -ne 0
    __bad "--dump-fonts exited $font_rc: "(string join ' ' (string match -r 'fonts:.*|metrics:.*' -- $font_out | head -n 2))
else if not set -q font_count[2]
    __bad '--dump-fonts printed no font count'
else if test $font_count[2] -lt 20
    __bad "the emboss text tool sees only $font_count[2] openable font(s) (expected at least 20)"
else if not set -q font_metrics[2]
    __bad 'the font metrics line is missing: a font opened without face data'
else if test $font_metrics[2] -lt 1
    __bad "font unit_per_em is $font_metrics[2]: the face was parsed without metrics"
else
    __ok "fonts: $font_count[2] openable, one opened with unit_per_em $font_metrics[2]"
end

set -l slice_out ($bin $model --selftest-slice 2>&1)
set -l slice_rc $status
set -l slice_match (string match -r 'slice finished in (\d+) ms: (\d+) layers, (\d+) moves' -- $slice_out)
if test $slice_rc -ne 0
    __bad "--selftest-slice exited $slice_rc"", see: "(string join ' ' (string match -r '^slice .*|error.*' -- $slice_out | head -n 3))
else if not set -q slice_match[3]
    __bad '--selftest-slice printed no layer count'
else if test $slice_match[3] -lt 100
    __bad "slice produced only $slice_match[3] layers (expected at least 100)"
else if test $slice_match[4] -lt 1
    __bad 'slice produced no moves'
else
    __ok "slice: $slice_match[3] layers, $slice_match[4] moves in $slice_match[2] ms"
end

# The plate gate: two models on one bed, sliced as one job. Parity alone cannot
# catch a scene regression -- every oracle case is a single object -- so this
# checks that both objects reach the toolpath, side by side on the bed.
#
# It cannot assert an exact move count: this engine's multi-object path is not
# bit-stable, and the difference is an extra pair of ~0.7 mm seam segments at the
# first-layer loop start (measured: 9,818 vs 9,820 of 125 layers, roughly one run
# in ten; pinned to one core it is 9,818 every time). The gate therefore asserts
# the shape of the toolpath -- object count, layers, a span wide enough for both
# objects -- and keeps the G-code at $plate_gcode so a difference can be diffed.
set -l second_model $root/oracle/models/bridge_30.stl
set -l plate_gcode /tmp/nl-check-plate.gcode
set -l scene_out ($bin $model $second_model --selftest-slice --keep-gcode $plate_gcode 2>&1)
set -l scene_rc $status
set -l scene_objects (string match -r '^mesh (\d+) objects' -- $scene_out)
set -l scene_match (string match -r 'slice finished in \d+ ms: (\d+) layers, (\d+) moves -> (.+)$' -- $scene_out)
if test $scene_rc -ne 0
    __bad "plate slice exited $scene_rc, see: "(string join ' ' (string match -r 'slice failed.*|error.*' -- $scene_out | head -n 3))
else if not set -q scene_match[4]
    __bad 'plate slice printed no result line'
else if test (count $scene_objects) -eq 2 -a "$scene_objects[2]" != 2
    __bad "the plate reported $scene_objects[2] object(s) after adding two models"
else
    set -l scene_span (python3 -c '
import sys
xs = []
for line in open(sys.argv[1]):
    if not line.startswith("G1 "):
        continue
    words = line.split()
    if not any(w[:1] == "E" and len(w) > 1 for w in words[1:]):
        continue
    for w in words:
        if w[:1] == "X":
            xs.append(float(w[1:]))
print(f"{max(xs) - min(xs):.1f} {len(xs)}" if xs else "0 0")
' $scene_match[4])
    set -l span_parts (string split ' ' -- $scene_span)
    if test (count $span_parts) -lt 2 -o $span_parts[2] -lt 1
        __bad "the plate toolpath has no extruding moves with an X coordinate"
    else if test $span_parts[1] -lt 40
        __bad "the plate toolpath spans only $span_parts[1] mm: the second object is missing"
    else
        __ok "plate: 2 objects, $scene_match[2] layers, $scene_match[3] moves, X span $span_parts[1] mm"
    end
end

# Branding gate: an exported G-code file is user-facing, and the engine stamps
# its own product name into the first line and into the JSON metadata. Both must
# read next-layer. The compatibility tokens (`; prusaslicer_config`) are a wire
# format and are deliberately not checked here, but no human-readable line may
# name another slicer.
set -l brand_gcode /tmp/nl-check-brand.gcode
rm -f $brand_gcode
env QT_QPA_PLATFORM=eglfs $bin $model --selftest-slice --keep-gcode $brand_gcode >/dev/null 2>&1
set -l brand_rc $status
if test $brand_rc -ne 0 -o ! -f $brand_gcode
    __bad 'branding: --selftest-slice produced no G-code to inspect'
else
    set -l brand_head (head -n 1 $brand_gcode)
    set -l brand_producer (grep -m1 -o '"producer": "[^"]*"' $brand_gcode)
    set -l brand_version (grep -m1 -o '"producer_version": "[^"]*"' $brand_gcode)
    set -l brand_leak (grep -c 'PrusaSlicer' $brand_gcode)
    if not string match -q '; generated by next-layer *' -- "$brand_head"
        __bad "branding: the header reads '$brand_head'"
    else if test "$brand_producer" != '"producer": "next-layer"'
        __bad "branding: the metadata producer is '$brand_producer'"
    else if test "$brand_version" != '"producer_version": "0.1.0"'
        __bad "branding: the metadata version is '$brand_version'"
    else if test $brand_leak -gt 0
        __bad "branding: $brand_leak line(s) still name PrusaSlicer"
    else
        __ok "branding: '$brand_head', $brand_producer, no foreign product name"
    end
end

# Plate tools gate: arrange, auto-orient and place-on-face all change geometry,
# and none of them shows up in a slice parity test -- arrange can pack objects
# overlapping and still export, auto-orient can leave an object floating. This
# runs the headless knob, which starts two identical cubes stacked on purpose,
# packs them apart, tilts one and lowers it back onto a face, and refuses to pass
# unless each tool changed the plate the way it claims.
set -l tools_home (mktemp -d /tmp/nl-check-tools-XXXXXX)
set -l tools_cfg /tmp/nl-check-tools.json
rm -f $tools_cfg
env XDG_DATA_HOME=$tools_home $bin --printer 'Anycubic Kobra 2 0.4' --process Standard --filament Generic --dump-config $tools_cfg >/dev/null 2>&1
set -l tools_out (env QT_QPA_PLATFORM=eglfs XDG_DATA_HOME=$tools_home $bin $model --plate-tools $tools_cfg 2>&1)
set -l tools_rc $status
set -l arrange_line (string match -r 'arrange: two overlapping cubes separated.*' -- $tools_out)
set -l orient_line (string match -r 'auto-orient: ([0-9.]+) mm tall tilted, ([0-9.]+) mm tall resting.*' -- $tools_out)
set -l face_line (string match -r 'place-on-face: facet \d+ laid flat.*' -- $tools_out)
if test $tools_rc -ne 0
    __bad "plate tools: exit $tools_rc, see "(string join ' ' (string match -r '^[a-z].*|.*refused.*|.*did not.*' -- $tools_out | head -n 2))
else if test (count $arrange_line) -eq 0
    __bad 'plate tools: arrange printed no verdict'
else if test (count $orient_line) -lt 3
    __bad 'plate tools: auto-orient printed no measurements'
else if test (count $face_line) -eq 0
    __bad 'plate tools: place-on-face printed no verdict'
else
    __ok "plate tools: arrange packs apart, auto-orient $orient_line[2] -> $orient_line[3] mm tall, place-on-face sits on the bed"
end

# Plate-feature gate: the three things a plate can carry beyond geometry have to
# reach the slicer, and none of them shows up in a single-object slice: a
# per-object setting, a layer height profile, and painted facets. The knob slices
# the same object four ways and measures each one in the toolpath -- layers for
# the first two, support moves for the paint.
set -l features_gcode /tmp/nl-check-features.gcode
set -l features_out (env QT_QPA_PLATFORM=eglfs XDG_DATA_HOME=$tools_home $bin $root/oracle/models/bridge_30.stl --slice-features $tools_cfg 2>&1)
set -l features_rc $status
set -l features_setting (string match -r 'per-object layer_height 0.30: ([0-9]+) layer\(s\) \(was ([0-9]+)\)' -- $features_out)
set -l features_profile (string match -r 'variable layer height .*: ([0-9]+) layer\(s\) \(was ([0-9]+)\)' -- $features_out)
set -l features_paint (string match -r 'support enforcer paint: ([0-9]+) support move\(s\) \(was ([0-9]+)\)' -- $features_out)
set -l features_marker (string match -r 'custom G-code at 2.00 mm: ([0-9]+) occurrence\(s\), inside layer ([0-9]+)' -- $features_out)
if test $features_rc -ne 0
    __bad "plate features: exit $features_rc, see "(string join ' ' (string match -r '^[a-z].*|.*did not.*|.*refused.*' -- $features_out | head -n 2))
else if test (count $features_setting) -lt 3
    __bad 'plate features: the per-object override printed no measurements'
else if test $features_setting[2] -ge $features_setting[3]
    __bad "plate features: a 0.30 mm per-object layer height gave $features_setting[2] layers, not fewer than $features_setting[3]"
else if test (count $features_profile) -lt 3
    __bad 'plate features: the layer height profile printed no measurements'
else if test $features_profile[2] -le $features_profile[3]
    __bad "plate features: a 0.10 mm band gave $features_profile[2] layers, not more than $features_profile[3]"
else if test (count $features_paint) -lt 3
    __bad 'plate features: the paint printed no measurements'
else if test $features_paint[2] -le $features_paint[3]
    __bad "plate features: painted facets gave $features_paint[2] support moves, unpainted $features_paint[3]"
else if test (count $features_marker) -lt 3
    __bad 'plate features: the custom G-code marker printed no measurements'
else if "$features_marker[2]" != "1"
    __bad "plate features: a custom G-code marker appeared $features_marker[2] time(s) in the G-code"
else
    __ok "plate features: per-object layer height $features_setting[3] -> $features_setting[2] layers, a 0.10 mm band $features_profile[3] -> $features_profile[2], paint $features_paint[2] support moves, a custom G-code marker lands once in layer $features_marker[3]"
end

# Shape gate: the CAD-suite half of the plate -- a primitive added as an object and
# a negative volume attached to it -- has to reach the slicer's booleans, and the
# only place that shows up is the toolpath. The knob slices a box, cuts a hole
# through it, removes the hole again and adds a second shape, and refuses to pass
# unless each step moved the extruding move count the way it must.
set -l shape_out (env QT_QPA_PLATFORM=eglfs XDG_DATA_HOME=$tools_home $bin --shape-test $tools_cfg 2>&1)
set -l shape_rc $status
set -l shape_box (string match -r 'added box .*: ([0-9]+) layer\(s\), ([0-9]+) extruding move\(s\), ([0-9.]+) mm' -- $shape_out)
set -l shape_cut (string match -r 'negative cylinder .*: ([0-9]+) move\(s\), ([0-9.]+) mm filament \(was ([0-9.]+) mm\)' -- $shape_out)
set -l shape_back (string match -r 'removed: ([0-9]+) move\(s\), ([0-9.]+) mm' -- $shape_out)
set -l shape_two (string match -r 'added cylinder .*: ([0-9]+) object\(s\), ([0-9]+) layer\(s\), ([0-9.]+) mm filament' -- $shape_out)
if test $shape_rc -ne 0
    __bad "shapes and volumes: exit $shape_rc, see "(string join ' ' (string match -r '^[a-z].*did not.*|.*refused.*|.*could not.*' -- $shape_out | head -n 2))
else if test (count $shape_box) -lt 3
    __bad 'shapes and volumes: the added box printed no measurements'
else if test (count $shape_cut) -lt 4
    __bad 'shapes and volumes: the negative volume printed no measurements'
else if not python3 -c "import sys; sys.exit(0 if float('$shape_cut[3]') < float('$shape_cut[4]') * 0.95 else 1)"
    __bad "shapes and volumes: a 24 mm hole used $shape_cut[3] mm of filament against the solid box's $shape_cut[4] mm"
else if test (count $shape_two) -lt 4
    __bad 'shapes and volumes: the second shape printed no measurements'
else if test $shape_two[2] -lt 2
    __bad "shapes and volumes: adding a cylinder gave $shape_two[2] object(s)"
else if not python3 -c "import sys; sys.exit(0 if float('$shape_two[4]') > float('$shape_back[3]') else 1)"
    __bad "shapes and volumes: adding a cylinder used $shape_two[4] mm against $shape_back[3] mm"
else
    __ok "shapes and volumes: a 40x40x20 box prints $shape_box[4] mm of filament, a 24 mm hole cuts it to $shape_cut[3] mm and removing it restores $shape_back[3] mm; a second shape makes $shape_two[2] objects"
end

# Project gate: a project file that loads but loses paint, overrides or a layer
# height profile is worse than no project file, and a project that loads but does
# not slice is not a project. The knob builds a plate with all three, saves it,
# clears the document, reloads the file, compares what came back, and slices the
# reloaded plate.
set -l project_out (env QT_QPA_PLATFORM=eglfs XDG_DATA_HOME=$tools_home $bin $root/oracle/models/bridge_30.stl --project-test $tools_cfg 2>&1)
set -l project_rc $status
set -l project_loaded (string match -r 'reloaded: ([0-9]+) object\(s\), ([0-9]+) override\(s\), ([0-9]+) profile band\(s\), ([0-9]+) support paint, ([0-9]+) tool paint' -- $project_out)
set -l project_sliced (string match -r 'the reloaded plate slices: ([0-9]+) layer\(s\), ([0-9]+) extruding move\(s\)' -- $project_out)
if test $project_rc -ne 0
    __bad "project file: exit $project_rc, see "(string join ' ' (string match -r 'save failed.*|load failed.*|.*lost data.*|.*did not slice.*' -- $project_out | head -n 2))
else if test (count $project_loaded) -lt 6
    __bad 'project file: the round trip printed no measurements'
else if test $project_loaded[2] -lt 2 -o $project_loaded[3] -lt 1 -o $project_loaded[4] -lt 2
    __bad "project file: came back with $project_loaded[2] object(s), $project_loaded[3] override(s), $project_loaded[4] profile band(s)"
else if test $project_loaded[5] -lt 1 -o $project_loaded[6] -lt 1
    __bad "project file: came back with $project_loaded[5] support paint and $project_loaded[6] tool paint"
else if test (count $project_sliced) -lt 3
    __bad 'project file: the reloaded plate printed no slice measurements'
else
    __ok "project file: $project_loaded[2] objects with $project_loaded[3] override(s), $project_loaded[4] profile band(s) and paint survived the round trip, and slice to $project_sliced[2] layers"
end

# User-preset gate: a preset a person saves has to survive a restart, resolve
# back into a slice and be renameable and deletable. The vendor catalogs write
# `id: 'Anycubic'` where the engine's own bundles write `id: Anycubic`, so this
# used to fail outright for every catalog printer -- "no preset bundle is loaded"
# for the machines people actually own.
set -l preset_home (mktemp -d /tmp/nl-check-userpresets-XXXXXX)
env XDG_DATA_HOME=$preset_home $bin --printer 'Anycubic Kobra 2 0.4' --process Standard --filament Generic --set layer_height=0.25 --save-preset 'print,Check Profile' >/tmp/nl-check-preset.out 2>&1
set -l preset_save_rc $status
set -l preset_file (find $preset_home -name 'print-Check Profile.yaml' 2>/dev/null | head -n 1)
set -l preset_cfg /tmp/nl-check-preset.json
rm -f $preset_cfg
env XDG_DATA_HOME=$preset_home $bin --printer 'Anycubic Kobra 2 0.4' --process 'Check Profile' --filament Generic --dump-config $preset_cfg >/tmp/nl-check-preset2.out 2>&1
set -l preset_resolve_rc $status
set -l preset_layer ""
if test -f $preset_cfg
    set preset_layer (python3 -c "import json;print(json.load(open('$preset_cfg'))['configuration']['print_settings']['layer_height'])" 2>/dev/null)
end
env XDG_DATA_HOME=$preset_home $bin --printer 'Anycubic Kobra 2 0.4' --process 'Check Profile' --filament Generic --rename-preset 'print,Check Profile,Check Renamed' >/dev/null 2>&1
set -l preset_rename_rc $status
set -l preset_renamed (find $preset_home -name 'print-Check Renamed.yaml' 2>/dev/null | head -n 1)
env XDG_DATA_HOME=$preset_home $bin --printer 'Anycubic Kobra 2 0.4' --process 'Check Renamed' --filament Generic --delete-preset 'print,Check Renamed' >/dev/null 2>&1
set -l preset_delete_rc $status
set -l preset_left (find $preset_home -name 'print-Check*.yaml' 2>/dev/null | wc -l)
rm -rf $preset_home
if test $preset_save_rc -ne 0 -o -z "$preset_file"
    __bad "user presets: saving one for a catalog printer failed ("(string match -r 'presets: .*' -- (cat /tmp/nl-check-preset.out) | head -n 1)")"
else if test $preset_resolve_rc -ne 0 -o "$preset_layer" != "0.25"
    __bad "user presets: the saved preset resolved with layer_height '$preset_layer', not 0.25"
else if test $preset_rename_rc -ne 0 -o -z "$preset_renamed"
    __bad 'user presets: renaming a saved preset failed'
else if test $preset_delete_rc -ne 0 -o "$preset_left" != "0"
    __bad "user presets: deleting a saved preset left $preset_left file(s) behind"
else
    __ok "user presets: saved, resolved (layer_height 0.25), renamed and deleted a preset for a catalog printer"
end

rm -rf $tools_home
# The catalog gate: the shipped vendor catalog has to load, and one printer from
# it -- not one of our own Prusa presets -- has to slice end to end. A preset that
# resolves but exports nothing looks identical to a good one in --dump-presets.
# The preset home is isolated so this measures the bundle in the build tree: the
# app prefers ~/.local/share/next-layer/presets, and a stale copy left there
# shadows a regenerated bundle without a word.
set -l catalog_home (mktemp -d /tmp/nl-check-presets-XXXXXX)
set catalog_out (env XDG_DATA_HOME=$catalog_home $bin --dump-presets 2>&1)
set -l catalog_count (printf '%s\n' $catalog_out | grep -cE 'extruders?\)')
# Resolution matches a hardware config by display name and takes the first hit,
# while config ids are fresh UUIDs on every load -- so two configs sharing a name
# resolve to a different machine from run to run. validate.py owns the parsing of
# the dump (names contain single spaces, so column slicing is not safe).
set -l names_out (python3 $root/tools/orca-catalog/validate.py --names-only --data-home $catalog_home 2>&1)
set -l names_rc $status
set -l names_match (string match -r '(\d+) hardware configs, (\d+) duplicate' -- $names_out)
set -l sample '(Anycubic Kobra 2 0.4)'
set -l sample_cfg /tmp/nl-check-catalog.json
set -l sample_gcode /tmp/nl-check-catalog.gcode
rm -f $sample_cfg $sample_gcode
env XDG_DATA_HOME=$catalog_home $bin --printer 'Anycubic Kobra 2 0.4' --process Standard --filament Generic --dump-config $sample_cfg >/dev/null 2>&1
set -l sample_rc $status
if test $names_rc -ne 0 -o (count $names_match) -eq 0 -o "$names_match[3]" != "0"
    __bad "printer catalog: duplicate printer names, so resolution picks whichever config the map happens to list first ("(string join ' ' (string match -r 'DUPLICATE .*' -- $names_out | head -n 2))
else if test $catalog_count -lt 400
    __bad "printer catalog: only $catalog_count printers listed (expected at least 400)"
else if test $sample_rc -ne 0 -o ! -f $sample_cfg
    __bad "printer catalog: a catalog printer did not resolve to a config ($sample)"
else
    env XDG_DATA_HOME=$catalog_home $bin $model --slice $sample_cfg,$sample_gcode >/dev/null 2>&1
    set -l sample_size 0
    if test -f $sample_gcode
        set sample_size (stat -c %s $sample_gcode)
    end
    if test $sample_size -lt 100000
        __bad "printer catalog: $sample sliced $sample_size bytes (expected a full G-code file)"
    else
        __ok "printer catalog: $catalog_count printers, no duplicate names, $sample slices $sample_size bytes"
    end
end
rm -rf $catalog_home
# Filament presets: a machine that lists one material cannot be used without
# inventing one, so the bundle next-layer ships for our own printer has to offer a
# real set, and each entry has to resolve and slice -- a filament that resolves but
# exports nothing looks identical in a profile dump.
set -l filament_out ($bin --dump-presets --printer 'Voron 2.4 350 0.4' 2>&1)
set -l filament_match (string match -r 'filament profiles: (\d+)' -- $filament_out)
set -l filament_cfg /tmp/nl-check-filament.json
set -l filament_gcode /tmp/nl-check-filament.gcode
rm -f $filament_cfg $filament_gcode
$bin --printer 'Voron 2.4 350 0.4' --process Standard --filament 'Generic PETG' --dump-config $filament_cfg >/dev/null 2>&1
set -l filament_rc $status
if not set -q filament_match[2]
    __bad 'filament presets: no profile list for our own printer'
else if test $filament_match[2] -lt 8
    __bad "filament presets: only $filament_match[2] materials for the Voron bundle (expected at least 8)"
else if test $filament_rc -ne 0 -o ! -f $filament_cfg
    __bad 'filament presets: Generic PETG did not resolve for the Voron bundle'
else
    $bin $model --slice $filament_cfg,$filament_gcode >/dev/null 2>&1
    set -l petg_size 0
    if test -f $filament_gcode
        set petg_size (stat -c %s $filament_gcode)
    end
    set -l petg_bed (grep -m1 -o 'M140 S[0-9]*' $filament_gcode 2>/dev/null)
    if test $petg_size -lt 100000
        __bad "filament presets: Generic PETG sliced $petg_size bytes"
    else if test "$petg_bed" != "M140 S80"
        __bad "filament presets: Generic PETG wrote '$petg_bed' instead of a PETG bed temperature"
    else
        __ok "filament presets: $filament_match[2] materials for the Voron bundle, Generic PETG slices $petg_size bytes at 80 C"
    end
end


set -l integrity_out (python3 $root/oracle/baseline_check.py 2>&1)
set -l integrity_rc $status
set -l integrity_tally (string match -r '(\d+)/(\d+) baseline files match the manifest' -- $integrity_out)
if test $integrity_rc -eq 0 -a (count $integrity_tally) -gt 0 -a "$integrity_tally[2]" = "$integrity_tally[3]"
    __ok "oracle baselines: $integrity_tally[2]/$integrity_tally[3] G-code files match the manifest"
else
    __bad "oracle baselines drifted from the manifest (python3 oracle/baseline_check.py): "(string join ' ' (string match -r '^  .*' -- $integrity_out | head -n 2))
end

if test $fast -eq 1
    __skip 'oracle verify (--fast)'
else
    set -l oracle_out (python3 $root/oracle/oracle.py verify --runner qt --bin $bin 2>&1)
    set -l oracle_rc $status
    set -l oracle_match (string match -r '(\d+)/(\d+) match baseline' -- $oracle_out)
    if test $oracle_rc -eq 0 -a (count $oracle_match) -gt 0 -a "$oracle_match[2]" = "$oracle_match[3]"
        __ok "oracle: $oracle_match[2]/$oracle_match[3] byte-identical to the baseline"
    else if test (count $oracle_match) -gt 0
        __bad "oracle: $oracle_match[2]/$oracle_match[3] match the baseline (see python3 oracle/oracle.py verify --runner qt)"
    else
        __bad "oracle: no verdict, exit $oracle_rc"", see: "(string join ' ' (string match -r '^.*[Tt]raceback.*|^[A-Za-z]*Error.*' -- $oracle_out | head -n 2))
    end
end

set -l shot /tmp/nl-check-model.png
set -l smoke_out (env QT_QPA_PLATFORM=eglfs QT_ASSUME_STDERR_HAS_CONSOLE=1 $bin $model --smoke --shot $shot 2>&1)
set -l smoke_rc $status
set -l smoke_match (string match -r 'frame (\d+)x(\d+), covered ([\d.]+)%' -- $smoke_out)
if test $smoke_rc -ne 0
    __bad "--smoke exited $smoke_rc"", see: "(string join ' ' (string match -r '^(smoke|error|qt\.).*' -- $smoke_out | head -n 3))
else if not set -q smoke_match[4]
    __bad '--smoke printed no coverage figure: the frame was never measured'
else if test (math "$smoke_match[4] - 50") -lt 0
    __bad "headless frame only $smoke_match[4]% covered: the scene did not render"
else
    __ok "headless frame: $smoke_match[4]% covered, $smoke_match[2]x$smoke_match[3] ($shot)"
end

if test $ui -eq 1
    set -l cockpit $root/tools/cockpit/cockpit
    set -l ui_shot /tmp/nl-check-ui.png
    set -l start_out ($cockpit start next-layer --model $model 2>&1)
    if test $status -ne 0
        __bad "cockpit start: $start_out"
    else
        $cockpit shot $ui_shot >/dev/null 2>&1
        set -l label_out ($cockpit find-text 'Slice' 2>&1)
        set -l label_rc $status
        set -l size 0
        if test -f $ui_shot
            set size (stat -c %s $ui_shot)
        end
        if test $label_rc -ne 0
            __bad "window: no 'Slice' control on screen ($ui_shot)"
        else if test $size -lt 20000
            __bad "window: capture is blank ($size bytes, $ui_shot)"
        else
            __ok "window: Slice control found, frame captured ($ui_shot)"
        end
        $cockpit stop >/dev/null 2>&1
    end
end

echo
set -l total (math $passed + $failed)
if test $failed -eq 0
    echo "$passed/$total gates passed"
    exit 0
end
echo "$passed/$total gates passed, $failed FAILED:"
for failure in $failures
    echo "  - $failure"
end
exit 1
